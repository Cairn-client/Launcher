<Project Sdk="Microsoft.NET.Sdk">

  <!--
    first-run setup test double for Warhorse's WorkspaceSetup.exe: prints the real
    tool's prompts and does what it does, but takes the two install folders as
    arguments instead of asking Steam. Never shipped; only
    Cairn.Setup.Tests runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FakeWorkspaceSetup</AssemblyName>
  </PropertyGroup>

</Project>
