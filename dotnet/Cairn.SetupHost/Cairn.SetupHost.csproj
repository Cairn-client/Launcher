<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CairnSetup.exe: the shared setup code (dotnet\Cairn.Setup) as a
    small native executable, for the two callers that cannot load it in-process:

      * Setup.exe, before anything is installed (no .NET runtime yet), runs
        "detect" so the installer and the launcher decide from the same code;
      * the launcher's one UAC step runs "link" elevated.

    WinExe on purpose: a console-subsystem exe started through UAC or by
    Inno's Exec gets a console window, and first-run setup allows no window at all.
    Output goes to the file named by out or status, never to a console.

    NativeAOT (about 2 MB, no runtime needed). Publishing needs the MSVC
    linker; ILCompiler finds it through vswhere, which lives in
    "%ProgramFiles(x86)%\Microsoft Visual Studio\Installer": put that folder
    on PATH first (tools\Publish-Release.ps1 does).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CairnSetup</AssemblyName>
    <RootNamespace>Cairn.SetupHost</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <VersionFileContent Condition="Exists('$(MSBuildThisFileDirectory)..\..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</VersionFileContent>
    <Version Condition="'$(VersionFileContent)' != ''">$([System.Version]::Parse('$(VersionFileContent)').Major).$([System.Version]::Parse('$(VersionFileContent)').Minor).0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cairn.Setup\Cairn.Setup.csproj" />
  </ItemGroup>

  <!--
    the native linker writes the full path of its PDB into the exe's debug directory (RSDS), and Roslyn's
    PathMap (Directory.Build.props, instrumentation) does not touch that: the 0.44.0 payload sweep found the build machine's
    Windows user name in CairnSetup.exe. /PDBALTPATH:%_PDB% embeds the PDB's file name only.
  -->
  <ItemGroup>
    <LinkerArg Include="/PDBALTPATH:%_PDB%" />
  </ItemGroup>

</Project>
