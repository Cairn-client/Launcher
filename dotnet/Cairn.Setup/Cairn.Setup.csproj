<Project Sdk="Microsoft.NET.Sdk">

  <!--
    first-run setup, shared by the launcher and the installer.

    One detection code for both: the launcher references this library
    directly, and Setup runs it through CairnSetup.exe (dotnet\Cairn.SetupHost,
    a NativeAOT build of this same code) before anything is installed. So the
    two can never disagree about where Steam, the game, the Modding Tools and
    the workspace are, or whether they are set up.

    No UI types here: the launcher draws the checklist; this decides it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Cairn.Setup</RootNamespace>
    <!-- Windows-only by nature (registry, links, Steam on Windows); the CA1416
         noise this would otherwise raise at every call site says nothing new. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <VersionFileContent Condition="Exists('$(MSBuildThisFileDirectory)..\..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</VersionFileContent>
    <Version Condition="'$(VersionFileContent)' != ''">$([System.Version]::Parse('$(VersionFileContent)').Major).$([System.Version]::Parse('$(VersionFileContent)').Minor).0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cairn.Setup.Tests" />
  </ItemGroup>

</Project>
