<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cairn.Wire</RootNamespace>
  </PropertyGroup>

  <!--
    NPC sync follow-up: stamp from the repo VERSION like Client/Server/launcher
    already do, so the launcher's partial-install check can compare this DLL's
    version against its own. Reads only, never writes VERSION (VERSIONING.md).
  -->
  <PropertyGroup>
    <VersionFileContent Condition="Exists('$(MSBuildThisFileDirectory)..\..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</VersionFileContent>
    <Version Condition="'$(VersionFileContent)' != ''">$([System.Version]::Parse('$(VersionFileContent)').Major).$([System.Version]::Parse('$(VersionFileContent)').Minor).0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
