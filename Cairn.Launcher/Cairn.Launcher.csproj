<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<LangVersion>preview</LangVersion>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<AssemblyName>Cairn.Launcher</AssemblyName>
		<RootNamespace>Cairn.Launcher</RootNamespace>
		<Product>Cairn Client</Product>
		<AssemblyTitle>Cairn Client</AssemblyTitle>
		<Company>Cairn</Company>
		<Authors>Cairn</Authors>
	</PropertyGroup>

	<!--
	  stamp this build with the repo's own VERSION file, the same way
	  Cairn.Client.csproj does, so Globals.Version shows the real shipped
	  version instead of the stale hardcoded "0.1.0" it carried before. Reads
	  only, never writes VERSION. See docs/VERSIONING.md.
	-->
	<PropertyGroup>
		<VersionFileContent Condition="Exists('$(MSBuildThisFileDirectory)..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</VersionFileContent>
		<Version Condition="'$(VersionFileContent)' != ''">$([System.Version]::Parse('$(VersionFileContent)').Major).$([System.Version]::Parse('$(VersionFileContent)').Minor).0</Version>
		<!-- Otherwise the SDK appends "+<git-commit-hash>" to InformationalVersion,
		     which both looks wrong in the status bar and breaks ReleaseVersionCompare's
		     Major.Minor.Patch parsing outright. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<!--
	  Cairn: one version file. VERSION is the release number (0.7.3): the launcher shows it as is, and the handshake between players compares only its
	  Major.Minor (the Version property above is Major.Minor.0), so every 0.7.x build plays with every other 0.7.x build.
	-->
	<PropertyGroup>
		<CairnVersion Condition="'$(VersionFileContent)' != ''">$(VersionFileContent)</CairnVersion>
	</PropertyGroup>
	<ItemGroup Condition="'$(CairnVersion)' != ''">
		<AssemblyMetadata Include="Cairn.Version" Value="$(CairnVersion)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Photino.Blazor" Version="4.0.13" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!-- same reason as Cairn.Client.csproj: the flat-merged
		     release folder holds System.Text.Json 10 (relay/master publishes);
		     this exe's deps.json must list that version too, or its loader
		     cannot resolve STJ 10's System.IO.Pipelines dependency. -->
		<PackageReference Include="System.Text.Json" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- ReleaseVersionCompare, the only piece of this project
		     the launcher needs; it does not speak the wire protocol itself. -->
		<ProjectReference Include="..\dotnet\Cairn.Protocol\Cairn.Protocol.csproj" />
		<!-- the first-run checklist; where Steam and the games are, the pack store, the clients of the pack program. -->
		<ProjectReference Include="..\dotnet\Cairn.Setup\Cairn.Setup.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- the seed: the one game the launcher can show before it has ever reached the catalog (Models/GameProfileRegistry.cs) -->
		<EmbeddedResource Include="Seed\*.json" LogicalName="Cairn.Launcher.Seed.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="**\*.razor" Exclude="bin\**;obj\**" />
		<Content Include="**\*.cshtml" Exclude="bin\**;obj\**" />
		<!-- ApplicationIcon above embeds this into the exe's own icon resource
		     (Explorer, shortcuts, taskbar when not running). Photino's window
		     needs its own copy on disk at runtime, see Program.cs's
		     SetIconFile call, so it must also ship as a physical file. -->
		<None Include="app.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\img\" />
	</ItemGroup>

	<!-- A self-contained publish puts the .NET runtime's 16 KB WindowsBase.dll (a facade with no WPF in it) beside the app, over the real
	     2 MB one from the Windows Desktop runtime pack, so anything that touches WPF (the in-game menu's overlay window) fails with
	     "Could not load file or assembly WindowsBase" in the published launcher while it works from a plain build. Put the real one back. -->
	<Target Name="UseRealWindowsBase" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
		<ItemGroup>
			<_RealWindowsBase Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x64\*\runtimes\win-x64\lib\net8.0\WindowsBase.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_RealWindowsBase)" DestinationFolder="$(PublishDir)" Condition="'@(_RealWindowsBase)' != ''" />
	</Target>

</Project>
