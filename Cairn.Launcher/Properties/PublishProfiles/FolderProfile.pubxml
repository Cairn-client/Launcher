<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!-- Self-contained so a friend never needs the .NET 8 desktop runtime
         installed to run this. Only set here, in the publish profile, so a
         plain `dotnet build`/`dotnet run` during development is untouched:
         forcing a RuntimeIdentifier at the project level would move dev build
         output under a win-x64 subfolder and break every path tools\*.ps1
         assumes. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- the app's own code is compiled ahead of time: the window comes up sooner (the first look at the PC took about half the time) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- the runtime ships a dozen translations of its own messages: the launcher is English, so they are left out (about 12 MB of the folder) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>