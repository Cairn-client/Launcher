@if (!string.IsNullOrEmpty(joinStatusMessage))
{
    @* the joiner's world transfer, from the agent's /join-status *@
    <div class="join-status-banner" style="position: fixed; left: 50%; bottom: @(string.IsNullOrEmpty(connStatusLine) ? "64px" : "112px"); transform: translateX(-50%); padding: 10px 22px; background: rgba(var(--cairn-shadow-rgb), 0.92); border: 1px solid var(--cairn-oak-lit); color: var(--cairn-parchment); font-size: 16px; z-index: 900;">
        @joinStatusMessage
        @if (joinStatusState is "choose" or "choose-bring" or "choose-fresh")
        {
            @* a first join to this host world -- the player's choice, before anything is asked of the host.
               only the choice that has a save of the host's game version is offered. *@
            <div style="margin-top: 8px; display: flex; gap: 12px; justify-content: center;">
                @if (joinStatusState != "choose-fresh")
                {
                    <button class="btn btn-primary" @onclick='() => SendJoinChoiceAsync("bring")'>Bring my character</button>
                }
                @if (joinStatusState != "choose-bring")
                {
                    <button class="btn btn-secondary" @onclick='() => SendJoinChoiceAsync("fresh")'>Start fresh</button>
                }
            </div>
        }
        else if (joinCanFresh)
        {
            @* no usable save (the message says why) -- the agent can join with a new character (mp_join_henry fresh) *@
            <div style="margin-top: 8px; display: flex; gap: 12px; justify-content: center;">
                <button class="btn btn-primary" @onclick='() => SendJoinChoiceAsync("fresh")'>Join with a new character</button>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(connStatusLine))
{
    @* the agent's connection in plain words (never raw exception text) *@
    <div class="conn-status-banner" style="position: fixed; left: 50%; bottom: 64px; transform: translateX(-50%); padding: 8px 20px; background: rgba(var(--cairn-shadow-rgb), 0.92); border: 1px solid @(connStatusBad ? "var(--cairn-blood)" : "var(--cairn-oak-lit)"); color: var(--cairn-parchment); font-size: 15px; z-index: 899; max-width: 80%; text-align: center;">
        @connStatusLine
    </div>
}

