@implements IDisposable
@using System.Threading
@using Cairn.Launcher.Models

@* The strip at the bottom of every page, laid out like Steam's: what is downloading and how far, and opened, the download page:
   the current download with its speed graph (network and disk), what is up next, the updates on offer, what finished. *@
@{
    var items = Manager.Snapshot();
    var active = items.FirstOrDefault(i => i.IsActive);
    var waiting = items.Where(i => i.IsWaiting).ToList();
    var finished = items.Where(i => i.IsFinished).Reverse().ToList();
    var queuedIds = new HashSet<string>(items.Where(i => !i.IsFinished).Select(i => i.GameId), StringComparer.OrdinalIgnoreCase);
    var pending = Updates.Where(u => !queuedIds.Contains(u.Game.Id)).ToList();
    double speed = Manager.SpeedBytesPerSecond;
    var left = Manager.Remaining;
    int open = items.Count(i => !i.IsFinished);
    int pct = active is null ? 0 : (int)(Math.Clamp(active.Progress, 0, 1) * 100);
}

<footer class="dl-footer @(expanded ? "open" : "")" aria-label="Downloads">

    @if (expanded)
    {
        <section class="dl-panel" aria-label="Downloads">
            <div class="dl-top">
                <div class="dl-now">
                    @if (active is not null)
                    {
                        @Capsule(active.GameId, "big")
                        <div class="dl-now-text">
                            <div class="dl-now-state">@(active.State == DownloadState.Installing ? "Installing" : "Downloading")</div>
                            <div class="dl-now-name">@active.GameName</div>
                            <div class="dl-now-ver">@(active.FromVersion is null ? active.ToVersion : $"{active.FromVersion} → {active.ToVersion}")</div>
                            <div class="dl-prog big"><span style="width: @(pct)%"></span></div>
                            <div class="dl-now-amount">
                                @(active.State == DownloadState.Installing ? "Putting the mod in the game..." : $"{Fmt.Size(active.BytesDone)} of {Fmt.Size(active.Size)}")
                                @if (left is { } t) { <span class="dim"> - @Left(t)</span> }
                            </div>
                            @if (active.State == DownloadState.Downloading)
                            {
                                <div class="dl-now-actions"><button class="dl-link" @onclick="() => Manager.Cancel(active.Id)">Cancel download</button></div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="dl-idle-icon @(Offline ? "warn" : pending.Count > 0 ? "gold" : "ok")" aria-hidden="true">
                            @if (Offline)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12.5"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            }
                            else if (pending.Count > 0)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><polyline points="7 11 12 16 17 11"/><path d="M5 20h14"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12.5 10 17.5 19 7.5"/></svg>
                            }
                        </span>
                        <div class="dl-now-text idle">
                            <div class="dl-idle-title">@(Offline ? "Cannot reach the mod catalog" : pending.Count > 0 ? (pending.Count == 1 ? "1 mod has an update" : $"{pending.Count} mods have an update") : "All your mods are up to date")</div>
                            <div class="dl-idle-sub">@(Checking ? "Checking now..." : LastChecked is { } lc ? $"Last checked {HomeLogic.Ago(lc, DateTime.UtcNow)}" : "Not checked yet")</div>
                            <div class="dl-now-actions">
                                <button class="dl-btn" disabled="@Checking" @onclick="OnCheck">@(Checking ? "Checking..." : "Check for updates")</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="dl-graphcard">
                    <div class="dl-gstats">
                        <div><span class="k">Current</span><span class="v">@Fmt.Rate(speed)</span></div>
                        <div><span class="k">Peak</span><span class="v">@Fmt.Rate(peakSpeed)</span></div>
                    </div>
                    <div class="dl-graph" aria-label="Network and disk over the last two minutes">
                        <svg viewBox="0 0 @GraphWidth @GraphHeight" preserveAspectRatio="none">
                            <polygon class="g-net-fill" points="@GraphArea(netHistory)" />
                            <polyline class="g-net" points="@GraphLine(netHistory)" />
                            <polyline class="g-disk" points="@GraphLine(diskHistory)" />
                        </svg>
                    </div>
                    <div class="dl-glegend">
                        <span class="lg net">Network <strong>@Fmt.Rate(speed)</strong></span>
                        <span class="lg disk">Disk <strong>@Fmt.Rate(diskNow)</strong></span>
                    </div>
                </div>
            </div>

            <div class="dl-lists">
                @if (waiting.Count > 0)
                {
                    <div class="dl-section">
                        <span>Up next <span class="n">@waiting.Count</span></span>
                        <button class="dl-link" @onclick="CancelWaiting">Unqueue all</button>
                    </div>
                    @for (int i = 0; i < waiting.Count; i++) { @WaitingRow(waiting[i], i, waiting.Count) }
                }

                @if (pending.Count > 0)
                {
                    <div class="dl-section">
                        <span>Updates available <span class="n">@pending.Count</span></span>
                        <button class="dl-link" @onclick="OnUpdateAll">Update all</button>
                    </div>
                    @foreach (var u in pending)
                    {
                        <div class="dl-row">
                            @Capsule(u.Game.Id, "")
                            <div class="dl-main">
                                <div class="dl-name">@u.Game.DisplayName</div>
                                <div class="dl-sub">Update to @u.Version</div>
                            </div>
                            <div class="dl-ctl">
                                <button class="dl-btn strong" @onclick="() => OnUpdate.InvokeAsync(u.Game.Id)">Update</button>
                            </div>
                        </div>
                    }
                }

                @if (finished.Count > 0)
                {
                    <div class="dl-section">
                        <span>Completed <span class="n">@finished.Count</span></span>
                        <button class="dl-link" @onclick="Manager.ClearFinished">Clear all</button>
                    </div>
                    @foreach (var f in finished)
                    {
                        <div class="dl-row done">
                            @Capsule(f.GameId, "")
                            <div class="dl-main">
                                <div class="dl-name">@f.GameName</div>
                                <div class="dl-sub @(f.State == DownloadState.Failed ? "err" : "")">@StateText(f)</div>
                            </div>
                            <div class="dl-ctl">
                                @if (f.State is DownloadState.Failed or DownloadState.Cancelled)
                                {
                                    <button class="dl-btn" @onclick="() => OnUpdate.InvokeAsync(f.GameId)">Try again</button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <button class="dl-bar @(active is not null ? "busy" : "")" aria-expanded="@(expanded ? "true" : "false")" title="@(expanded ? "Close" : "Manage updates")" @onclick="Toggle">
        @if (active is not null)
        {
            <span class="dl-bar-line"><span style="width: @(pct)%"></span></span>
        }
        <span class="dl-bar-left">
            <svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="7 11 12 16 17 11"/><path d="M5 21h14"/></svg>
            <span>Manage updates</span>
        </span>
        <span class="dl-bar-mid">
            @if (active is not null)
            {
                <strong>@(active.State == DownloadState.Installing ? "Installing" : "Downloading")</strong>
                <span>@active.GameName</span>
                <span class="dim">@(active.State == DownloadState.Installing ? "" : $"{Fmt.Size(active.BytesDone)} of {Fmt.Size(active.Size)}")</span>
            }
            else if (waiting.Count > 0)
            {
                <strong>@waiting.Count in the queue</strong>
            }
            else if (pending.Count > 0)
            {
                <strong class="warn">@(pending.Count == 1 ? "1 mod has an update" : $"{pending.Count} mods have an update")</strong>
            }
        </span>
        <span class="dl-bar-right">
            @if (active is not null)
            {
                <span>@(active.State == DownloadState.Downloading ? Fmt.Rate(speed) : "")</span>
                <span class="dim">@(open > 1 ? $"{open} items" : "")</span>
            }
            <svg class="dl-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="@(expanded ? "6 9 12 15 18 9" : "6 15 12 9 18 15")"/></svg>
        </span>
    </button>
</footer>

@code {
    private const int GraphWidth = 240, GraphHeight = 70, HistoryLength = 120;

    [Parameter, EditorRequired] public DownloadManager Manager { get; set; } = default!;
    /// <summary>Installed mods that have a newer version.</summary>
    [Parameter] public IReadOnlyList<HomeModRow> Updates { get; set; } = Array.Empty<HomeModRow>();
    [Parameter] public bool Checking { get; set; }
    /// <summary>When the catalog was last read, or null if it has not been.</summary>
    [Parameter] public DateTime? LastChecked { get; set; }
    /// <summary>The catalog could not be read, so nothing can be said about updates.</summary>
    [Parameter] public bool Offline { get; set; }
    [Parameter] public EventCallback<string> OnUpdate { get; set; }
    [Parameter] public EventCallback OnUpdateAll { get; set; }
    [Parameter] public EventCallback OnCheck { get; set; }

    private bool expanded;
    private Timer? timer;
    private readonly SystemMetrics metrics = new();
    private double diskNow;
    private readonly List<double> netHistory = new();
    private readonly List<double> diskHistory = new();
    private double peakSpeed;

    private static class Fmt
    {
        public static string Rate(double v) => SystemMetrics.Rate(v);
        public static string Size(double v) => SystemMetrics.Size(v);
    }

    protected override void OnInitialized()
    {
        for (int i = 0; i < HistoryLength; i++) { netHistory.Add(0); diskHistory.Add(0); }
        metrics.SampleDiskWrite();   // the first reading only sets the baseline
        timer = new Timer(_ => _ = InvokeAsync(Tick), null, 1000, 1000);
    }

    private void Tick()
    {
        double speed = Manager.SpeedBytesPerSecond;
        diskNow = metrics.SampleDiskWrite();
        // the graph is about the download: while nothing downloads the launcher's other writes (logs, settings) are not drawn
        if (!Manager.Busy) diskNow = 0;
        Push(netHistory, speed);
        Push(diskHistory, diskNow);
        if (speed > peakSpeed) peakSpeed = speed;
        if (expanded) StateHasChanged();   // collapsed, the page repaints the strip whenever a download moves
    }

    private static void Push(List<double> history, double v)
    {
        history.Add(v);
        if (history.Count > HistoryLength) history.RemoveAt(0);
    }

    private void Toggle() => expanded = !expanded;

    private void CancelWaiting()
    {
        foreach (var i in Manager.Snapshot().Where(i => i.IsWaiting)) Manager.Cancel(i.Id);
    }

    // the graph: both lines share one scale, so the disk line can be compared with the network line
    private double Scale => Math.Max(1_000_000, Math.Max(netHistory.Max(), diskHistory.Max()) * 1.15);

    private string GraphLine(List<double> h)
    {
        double s = Scale, step = GraphWidth / (double)(HistoryLength - 1);
        return string.Join(" ", h.Select((v, i) => FormattableString.Invariant($"{i * step:0.#},{GraphHeight - Math.Min(v / s, 1) * (GraphHeight - 2) - 1:0.#}")));
    }

    private string GraphArea(List<double> h) =>
        FormattableString.Invariant($"0,{GraphHeight} ") + GraphLine(h) + FormattableString.Invariant($" {GraphWidth},{GraphHeight}");

    private static string Left(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours} h {t.Minutes} min left" : t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes} min {t.Seconds} s left" : $"{Math.Max(1, (int)t.TotalSeconds)} s left";

    private static string StateText(DownloadItem i) => i.State switch
    {
        DownloadState.Done => $"{(i.FromVersion is null ? "Downloaded" : "Updated to")} {i.ToVersion} ({Fmt.Size(i.Size)})" + (i.FinishedUtc is { } f ? " - " + HomeLogic.Ago(f, DateTime.UtcNow) : ""),
        DownloadState.Failed => i.Message.Length > 0 ? i.Message : "Failed",
        _ => "Cancelled"
    };

    // a game's picture (its logo on a dark tile), the size "big" for the current download
    private RenderFragment Capsule(string gameId, string size) => @<span class="dl-logo @size">@if (GameProfileRegistry.Get(gameId) is { LogoImage.Length: > 0 } g) { <img src="@g.LogoImage" alt="" /> } else { @gameId.ToUpperInvariant() }</span>;

    // a download that waits, with the controls to order it
    private RenderFragment WaitingRow(DownloadItem item, int index, int count) => @<div class="dl-row">
        @Capsule(item.GameId, "")
        <div class="dl-main">
            <div class="dl-name">@item.GameName <span class="dl-ver">@(item.FromVersion is null ? item.ToVersion : $"{item.FromVersion} → {item.ToVersion}")</span></div>
            <div class="dl-sub">@Fmt.Size(item.Size) - @(index == 0 ? "next" : $"{index + 1} in line")</div>
        </div>
        <div class="dl-ctl">
            <button class="dl-icon-btn" title="Download this one first" aria-label="Download first" disabled="@(index == 0)" @onclick="() => Manager.MoveFirst(item.Id)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 11 12 5 18 11"/><line x1="6" y1="19" x2="18" y2="19"/></svg>
            </button>
            <button class="dl-icon-btn" title="Move up" aria-label="Move up" disabled="@(index == 0)" @onclick="() => Manager.Move(item.Id, -1)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>
            </button>
            <button class="dl-icon-btn" title="Move down" aria-label="Move down" disabled="@(index >= count - 1)" @onclick="() => Manager.Move(item.Id, 1)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <button class="dl-icon-btn danger" title="Take it out of the queue" aria-label="Unqueue" @onclick="() => Manager.Cancel(item.Id)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
    </div>;

    public void Dispose() => timer?.Dispose();
}
