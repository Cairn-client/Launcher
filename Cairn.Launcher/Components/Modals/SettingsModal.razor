@inherits ModalBase
@using Cairn.Launcher.Models
@using Cairn.Launcher.Pages
@using System.Windows.Forms
@using System.Threading
@using Cairn.Setup

@* Cairn: one dialog, two scopes. "general" is the menu bar's Settings (what belongs to Cairn itself); a game id is that game's own
   settings, opened from the button next to Host and Join on its page. The values are the same keys of settings.json either way. *@
@if (IsVisible || Inline)
{
    var game = Scope == GeneralScope ? null : GameProfileRegistry.Get(Scope);
    RenderFragment savesList = @<div class="cairn-input-group saves-fill">
        <label class="cairn-label">Saved games</label>
        @if (!SavesKnown)
        {
            <div class="cairn-hint">@(SavesLoading ? "Reading the game's saves..." : "The game's saves are listed here once its mod is installed.")</div>
        }
        else if (Saves.Count == 0)
        {
            <div class="cairn-hint">No saves yet.</div>
        }
        else
        {
            <div class="save-list">
                @foreach (var slot in Saves)
                {
                    <div class="save-row">
                        <div class="save-main"><span class="save-name">@slot.Name</span><span class="save-detail">@slot.Detail</span></div>
                        <span class="save-when">@(slot.When is { } w ? w.ToLocalTime().ToString("d MMM HH:mm") : "")</span>
                        <button class="cairn-btn save-delete @(DeleteSaveAsked == slot.Id ? "danger" : "")" @onclick="() => OnDeleteSave.InvokeAsync(slot.Id)">@(DeleteSaveAsked == slot.Id ? "SURE? DELETE" : "DELETE")</button>
                    </div>
                }
            </div>
            @if (GameRunning)
            {
                <div class="cairn-hint">The game is running: a save written in the last ten minutes is kept, since the game may be using it.</div>
            }
        }
    </div>;
    RenderFragment body = @<div class="modal-content" style="text-align: left;">
                @if (game is null)
                {
                    <div class="modal-title" style="text-align: center;">SETTINGS</div>
                }
                else
                {
                    <div class="modal-title" style="text-align: center;">@game.DisplayName.ToUpperInvariant()</div>
                    <div class="settings-scope">Game settings</div>
                }

                @{
                    // a game with saves has two pages: its settings, and its saves (the list scrolls)
                    bool gameHasSaves = game is not null && (ExeIsSetting || (SavesKnown && Saves.Count > 0));
                    bool onSaves = gameHasSaves && gameTab == "saves";
                }
                @if (gameHasSaves)
                {
                    <div class="settings-tabs" role="tablist" aria-label="Game settings">
                        <button class="settings-tab @(!onSaves ? "on" : "")" role="tab" aria-selected="@(!onSaves ? "true" : "false")" @onclick='() => gameTab = "settings"'>Settings</button>
                        <button class="settings-tab @(onSaves ? "on" : "")" role="tab" aria-selected="@(onSaves ? "true" : "false")" @onclick='() => gameTab = "saves"'>Saves</button>
                    </div>
                }

                <div class="settings-body @(onSaves ? "saves-page" : "")">
                @if (game is null)
                {
                    @* Cairn: the paths of the mod's own programs, the master server and the info port are not the player's to set (the installer puts them); they keep their saved values. *@
                    <input class="cairn-input settings-search" type="search" placeholder="Search settings" aria-label="Search settings" @bind="query" @bind:event="oninput" />

                    @if (!Searching)
                    {
                        <div class="settings-tabs" role="tablist" aria-label="Settings">
                            @foreach (var t in Tabs)
                            {
                                var tabId = t.Id;
                                <button class="settings-tab @(tab == tabId ? "on" : "")" role="tab" aria-selected="@(tab == tabId ? "true" : "false")" @onclick="() => tab = tabId">@t.Title</button>
                            }
                        </div>
                    }
                    else if (!AnyMatch)
                    {
                        <div class="settings-empty">No setting matches "@query".</div>
                    }

                    @* ---- General ---- *@
                    @if (Show("startpage"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label">Page shown when Cairn starts</label>
                        <select class="cairn-input" @bind="Settings.StartPage">
                            <option value="home">Home</option>
                            <option value="library">Library</option>
                        </select>
                    </div>
                    }

                    @if (Show("confirmquit"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.ConfirmQuit" />
                            Pressing Escape on a page asks whether to close Cairn
                        </label>
                        <div class="cairn-hint">Off: Escape does nothing there (it still closes a window or a menu that is open).</div>
                    </div>
                    }

                    @if (Show("updates"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.AutoUpdateCairn" />
                            Install a new Cairn by itself when the launcher starts
                        </label>
                        <div class="cairn-hint">The installer runs with no windows and Cairn opens again. Off: a new version is announced and waits for you. Friends need the same version to play together.</div>
                    </div>
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.AutoUpdateMods" />
                            Keep my mods up to date by themselves
                        </label>
                        <div class="cairn-hint">A newer version of a mod you have is downloaded and put in the game in the background, never while a game is running. "Go back" on the game's page undoes an update.</div>
                    </div>
                    }

                    @* ---- Appearance ---- *@
                    @if (Show("accent"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label">Accent colour</label>
                        <div class="accent-choices">
                            @foreach (var (id, name, color) in Accents)
                            {
                                <button type="button" class="accent-choice @(Settings.AccentColor == id ? "on" : "")" style="--swatch: @color;" title="@name" aria-label="@name" aria-pressed="@(Settings.AccentColor == id)" @onclick="() => Settings.AccentColor = id"></button>
                            }
                        </div>
                        <div class="cairn-hint">The colour of buttons, rings and highlights. It shows when you save.</div>
                    </div>
                    }

                    @if (Show("motion"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.ReduceMotion" />
                            Reduce motion
                        </label>
                        <div class="cairn-hint">Turns the animations off: the spinning rings, the slideshow's slides and the fades.</div>
                    </div>
                    }

                    @if (Show("slideshow"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.SlideshowAuto" />
                            Change the slides on Home by themselves
                        </label>
                    </div>
                    }

                    @* ---- Notifications ---- *@
                    @if (Show("notifyfriends"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.NotifyFriends" />
                            Tell me when a friend comes online, starts playing or invites me
                        </label>
                    </div>
                    }

                    @if (Show("traynotices"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.TrayNotices" />
                            Also show Windows notifications (when a friend hosts, or invites me)
                        </label>
                        <div class="cairn-hint">So you see them while the game is in front or Cairn is minimised.</div>
                    </div>
                    }

                    @if (Show("notifyupdates"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.NotifyUpdates" />
                            Tell me when a mod was updated in the background
                        </label>
                    </div>
                    }

                    @* ---- Privacy ---- *@
                    @if (Show("presence"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.PresenceEnabled" />
                            Let my Steam friends who use Cairn see when I am online and invite me
                        </label>
                        <div class="cairn-hint">Your Steam name and friend ids go to the Cairn server while the launcher is open. A friend is shown only when you both list each other. Takes effect the next time the launcher starts.</div>
                    </div>
                    }

                    @if (Show("friendstatus"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.FriendStatus" />
                            Show what my Steam friends are doing, and their pictures
                        </label>
                        <div class="cairn-hint">Cairn asks each friend's public Steam profile page (steamcommunity.com) and loads their picture from Steam. Off: the friends list shows names only, and nothing is asked of Steam.</div>
                    </div>
                    }

                    @if (Show("addr"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.ShowHostAddress" />
                            Show my IP address in the Host window (hidden by default)
                        </label>
                        <div class="cairn-hint">Only for friends who join by address instead of Steam. Keep it hidden when you stream or share your screen.</div>
                    </div>
                    }

                    @* ---- Hosting ---- *@
                    @if (Show("port"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label">Host Port</label>
                        <input class="cairn-input" type="number" @bind="Settings.HostPort" />
                    </div>
                    }

                    @if (Show("steamjoin"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.HostAllowSteam" />
                            Let friends join me through Steam (when I host)
                        </label>
                    </div>
                    }

                    @if (Show("connectgate"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.ConnectGate" />
                            Wait until the world is loaded before the CONNECT button works
                        </label>
                        <div class="cairn-hint">The button says why it waits. Off: it is always enabled.</div>
                    </div>
                    }

                    @if (Show("takeover"))
                    {
                    <div class="cairn-input-group">
                        <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" @bind="Settings.MenuTakeover" />
                            Show Cairn's Start Game / Join Game on the game's main menu
                        </label>
                        <div class="cairn-hint">For games Cairn starts. Off: the game's own menu, as it comes.</div>
                    </div>
                    }

                    @if (Show("logs"))
                    {
                    @* Cairn: the logs of this PC (the game's, the agent's, the launcher's) in one zip on the Desktop, to send with a bug report *@
                    <div class="cairn-input-group">
                        <button class="cairn-btn" @onclick="OnCollectLogs">SAVE THE LOGS</button>
                        <div class="cairn-hint">One zip with the game's, the agent's and the launcher's logs. Best saved after you close the game.</div>
                    </div>
                    }

                    @if (Show("uninstall"))
                    {
                    @* Cairn: remove the mod and the launcher; the game's saves and the mod's own data (characters, chests, start save) stay *@
                    <div class="cairn-input-group">
                        @if (!confirmUninstall)
                        {
                            <button class="cairn-btn" @onclick="() => confirmUninstall = true">UNINSTALL CAIRN</button>
                            <div class="cairn-hint">Removes the mod from your games and this launcher. Your game saves stay, and so do the mod's own data (your characters, chests and start save, copied to Documents\Cairn-kept).</div>
                        }
                        else
                        {
                            <div class="cairn-hint" style="color: var(--cairn-warn);">Remove Cairn now? The launcher closes and the uninstaller removes it. Your saves are kept.</div>
                            <div style="display: flex; gap: 10px; margin-top: 8px;">
                                <button class="cairn-btn primary" @onclick="DoUninstall">YES, UNINSTALL</button>
                                <button class="cairn-btn" @onclick="() => confirmUninstall = false">KEEP IT</button>
                            </div>
                        }
                    </div>
                    }
                }
                else if (onSaves)
                {
                    @* the game's saves page: the start save, delete all, and the list of saves (it scrolls) *@
                    @if (ExeIsSetting)
                    {
                        <div class="cairn-input-group">
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                <button class="cairn-btn" @onclick="OnAddStartSave">ADD A START SAVE...</button>
                                <button class="cairn-btn" @onclick="OnOpenStartSave">OPEN ITS FOLDER</button>
                            </div>
                            <div class="cairn-hint">Needed once, to <i>Join with a new character</i> or start a <i>New adventure</i>. Pick a save of your own Modding Tools game, played past the prologue; the launcher checks it and puts it in place.</div>
                        </div>

                        <div class="cairn-input-group">
                            @if (!confirmDeleteSaves)
                            {
                                <button class="cairn-btn danger" disabled="@GameRunning" @onclick="() => confirmDeleteSaves = true">DELETE ALL SAVES</button>
                                <div class="cairn-hint">Deletes every save of the game and the characters and chests the mod kept, to start clean. The start saves stay. Close the game first.</div>
                            }
                            else
                            {
                                <div class="cairn-hint" style="color: var(--cairn-warn);">Delete every save of the game and everything the mod kept? This cannot be undone.</div>
                                <div style="display: flex; gap: 10px; margin-top: 8px;">
                                    <button class="cairn-btn danger" @onclick="DeleteSavesAsync">YES, DELETE ALL</button>
                                    <button class="cairn-btn" @onclick="() => confirmDeleteSaves = false">CANCEL</button>
                                </div>
                            }
                        </div>
                    }

                    @savesList
                }
                else if (ExeIsSetting)
                {
                    <div class="settings-section">Game</div>

                    <div class="cairn-input-group">
                        <label class="cairn-label">Game executable path</label>

                        <div style="display: flex; gap: 10px;">
                            <input class="cairn-input" @bind="Settings.GamePath" style="flex-grow: 1;" />

                            <button class="cairn-btn" @onclick="BrowseGamePath" style="padding: 8px 15px; font-size: 12px;">
                                BROWSE
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Settings.GamePath) && ExeNote.Length > 0)
                        {
                            <div class="cairn-hint" style="color: var(--cairn-warn);">@ExeNote</div>
                        }
                    </div>

                    <div class="cairn-input-group">
                        <label class="cairn-label">Advanced: Steam app for Steam connections</label>
                        <select class="cairn-input" value="@Settings.SteamAppId" @onchange="e => Settings.SteamAppId = uint.TryParse(e.Value?.ToString(), out var a) ? a : 2429020u">
                            <option value="2429020">KCD2 Modding Tools (2429020) - default</option>
                            <option value="480">Spacewar (480) - Valve's test app</option>
                            <option value="1771300">KCD2 retail (1771300)</option>
                        </select>
                        <div class="cairn-hint">Both players must use the same one. Leave it unless the tester page says otherwise.</div>
                    </div>

                    @* Release channel: stable or beta versions of the mod *@
                    @if (game.ModRepo.Length > 0)
                    {
                        <div class="settings-section">Updates</div>
                        <div class="cairn-input-group">
                            <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" checked="@(IsBetaChannel(game.Id))" @onchange="() => OnToggleChannel.InvokeAsync(game.Id)" />
                                Receive beta versions of this mod
                            </label>
                            <div class="cairn-hint">Beta versions offer the latest multiplayer features and fixes earlier. Both players in a session should use the same version.</div>
                        </div>
                    }

                }
                else
                {
                    @if (game.ModRepo.Length > 0)
                    {
                        <div class="settings-section">Updates</div>
                        <div class="cairn-input-group">
                            <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" checked="@(IsBetaChannel(game.Id))" @onchange="() => OnToggleChannel.InvokeAsync(game.Id)" />
                                Receive beta versions of this mod
                            </label>
                            <div class="cairn-hint">Beta versions offer the latest multiplayer features and fixes earlier. Both players in a session should use the same version.</div>
                        </div>
                    }
                    else
                    {
                        <div class="settings-empty">
                            <strong>@game.DisplayName</strong> has no settings yet. They appear here once multiplayer for this game is available.
                        </div>
                    }
                }

                @* the toggles the game's own mod offers (game.json "options"): saved with this window, done by the pack's program *@
                @if (game is not null && !onSaves && game.Options.Count > 0)
                {
                    <div class="settings-section">Options</div>
                    @foreach (var option in game.Options)
                    {
                        var status = OptionStatuses.TryGetValue(option.Id, out var st) ? st : null;
                        bool unavailable = status is { Available: false } || (option.Requires == "nvidia-rtx" && status is null);
                        bool locked = unavailable || OptionsBusy || GameRunning;
                        <div class="cairn-input-group">
                            <label class="cairn-label" style="display: flex; align-items: center; gap: 8px; cursor: @(locked ? "not-allowed" : "pointer");">
                                <input type="checkbox" checked="@IsOptionOn(game.Id, option.Id)" disabled="@locked" @onchange="e => SetOptionOn(game.Id, option.Id, e.Value is true)" />
                                @option.Title
                            </label>
                            @if (GameRunning)
                            {
                                <div class="cairn-hint" style="color: var(--cairn-warn);">Close the game first: this can only be changed while it is not running.</div>
                            }
                            @if (status is not null && status.Note.Length > 0 && option.Hint.Length == 0) { <div class="cairn-hint">@status.Note</div> }
                            @if (option.Hint.Length > 0) { <div class="cairn-hint">@option.Hint</div> }
                        </div>
                    }
                }

                </div>
                <div class="modal-actions">
                    <button class="cairn-btn primary" @onclick="OnSave">SAVE & CLOSE</button>
                    <button class="cairn-btn" @onclick="CloseModalAsync">CANCEL</button>
                </div>
            </div>;

    @if (Inline)
    {
        <div class="settings-page-wrap">@body</div>
    }
    else
    {
        <div class="modal-overlay @(isClosing ? "closing" : "" )">
            <div class="modal-box" @onclick:stopPropagation="true">
                <div class="modal-frame-top modal-frame-bg"></div>
                @body
                <div class="modal-frame-bottom modal-frame-bg"></div>
            </div>
        </div>
    }
}

@code {
    /// <summary>Shown as a page of the launcher (the Settings view) instead of a popup.</summary>
    [Parameter] public bool Inline { get; set; }
    [Parameter] public AppSettings Settings { get; set; } = new();
    /// <summary>"general" (the menu bar's Settings) or a game profile id (that game's settings).</summary>
    [Parameter] public string Scope { get; set; } = GeneralScope;
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnUninstall { get; set; }
    [Parameter] public EventCallback OnCollectLogs { get; set; }
    [Parameter] public EventCallback OnAddStartSave { get; set; }
    [Parameter] public EventCallback OnDeleteSaves { get; set; }
    private bool confirmDeleteSaves;
    private async Task DeleteSavesAsync() { confirmDeleteSaves = false; await OnDeleteSaves.InvokeAsync(); }
    [Parameter] public EventCallback OnOpenStartSave { get; set; }
    /// <summary>The game's executable is a setting of the launcher (Kingdom Come II's Modding Tools build): its path is asked for here.</summary>
    [Parameter] public bool ExeIsSetting { get; set; }
    /// <summary>What the game's pack says is wrong with the executable path, in its words ("" = nothing).</summary>
    [Parameter] public string ExeNote { get; set; } = "";
    /// <summary>What the pack's program said about each of the game's options on this PC (id to status); empty until it has answered.</summary>
    [Parameter] public IReadOnlyDictionary<string, Cairn.Setup.OptionStatus> OptionStatuses { get; set; } = new Dictionary<string, Cairn.Setup.OptionStatus>();
    /// <summary>The game's saves (its bridge while it runs, its program otherwise) and what the window is doing with them.</summary>
    [Parameter] public IReadOnlyList<BridgeSaveSlot> Saves { get; set; } = Array.Empty<BridgeSaveSlot>();
    [Parameter] public bool SavesKnown { get; set; }
    [Parameter] public bool SavesLoading { get; set; }
    [Parameter] public string? DeleteSaveAsked { get; set; }
    [Parameter] public bool ShowAllSaves { get; set; }
    [Parameter] public EventCallback<string> OnDeleteSave { get; set; }
    [Parameter] public EventCallback OnToggleShowAllSaves { get; set; }
    private const int SavesShown = 6;   // the list can be long (Kingdom Come II rotates its autosaves): the newest few, the rest on a click
    [Parameter] public bool OptionsBusy { get; set; }

    private bool IsOptionOn(string gameId, string optionId) => Settings.GameOptions.TryGetValue(gameId, out var o) && o.TryGetValue(optionId, out var on) && on;
    private void SetOptionOn(string gameId, string optionId, bool on)
    {
        if (!Settings.GameOptions.TryGetValue(gameId, out var o)) Settings.GameOptions[gameId] = o = new Dictionary<string, bool>();
        o[optionId] = on;
    }
    [Parameter] public EventCallback<string> OnToggleChannel { get; set; }
    [Parameter] public bool GameRunning { get; set; }
    public const string GeneralScope = "general";
    private bool confirmUninstall;

    private bool IsBetaChannel(string gameId) =>
        Settings.ModChannels.TryGetValue(gameId, out var c) && string.Equals(c, "beta", StringComparison.OrdinalIgnoreCase);

    // ---- the General settings are tabs; the search box looks across all of them ----
    private string tab = "general";

    private static readonly (string Id, string Name, string Color)[] Accents =
    {
        ("gold", "Gold", "#E8A35A"), ("blue", "Blue", "#5AA9E8"), ("green", "Green", "#6FCF8A"),
        ("pink", "Pink", "#E86AA8"), ("violet", "Violet", "#9B7BE8"), ("red", "Red", "#E8635A"),
    };
    private string gameTab = "settings";   // a game with saves has two pages: "settings" and "saves"
    private string query = "";

    private static readonly (string Id, string Title)[] Tabs =
    {
        ("general", "General"), ("appearance", "Appearance"), ("notifications", "Notifications"), ("privacy", "Privacy"), ("hosting", "Hosting"), ("support", "Support"),
    };

    // every setting: its tab, and the words it can be found by
    private static readonly Dictionary<string, (string Tab, string Words)> Index = new()
    {
        ["startpage"] = ("general", "start page home library opens first launch"),
        ["confirmquit"] = ("general", "escape key ask close quit exit confirm"),
        ["updates"] = ("general", "update automatically install new version mods background keep up to date cairn"),
        ["accent"] = ("appearance", "accent colour color theme gold blue green pink violet red"),
        ["motion"] = ("appearance", "reduce motion animation animations fade spinner"),
        ["slideshow"] = ("appearance", "slideshow slides home change automatically carousel"),
        ["notifyfriends"] = ("notifications", "friends online notifications playing invite tell me"),
        ["traynotices"] = ("notifications", "windows notifications tray toast hosting invite"),
        ["notifyupdates"] = ("notifications", "mod updated background update notice"),
        ["presence"] = ("privacy", "presence online invite friends cairn server see me"),
        ["friendstatus"] = ("privacy", "friends status pictures avatars steam profile community"),
        ["addr"] = ("privacy", "show ip address host window hidden stream share screen"),
        ["port"] = ("hosting", "host port network tcp address 7778 listen"),
        ["steamjoin"] = ("hosting", "let friends join through steam when i host"),
        ["connectgate"] = ("hosting", "connect button wait world loaded gate"),
        ["takeover"] = ("hosting", "main menu start game join game takeover"),
        ["logs"] = ("support", "save the logs zip bug report desktop game agent launcher"),
        ["uninstall"] = ("support", "maintenance uninstall cairn remove launcher mod"),
    };

    private bool Searching => !string.IsNullOrWhiteSpace(query);

    private bool Matches(string id)
    {
        string text = (Index[id].Words + " " + Index[id].Tab).ToLowerInvariant();
        return query.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries).All(w => text.Contains(w));
    }

    private bool Show(string id) => Searching ? Matches(id) : Index[id].Tab == tab;

    private bool AnyMatch => Index.Keys.Any(Matches);
    private async Task DoUninstall() { confirmUninstall = false; await OnUninstall.InvokeAsync(); }

    private void BrowseGamePath()
    {
        var thread = new Thread(() =>
        {
            var dialog = new OpenFileDialog();
            dialog.Filter = "KingdomCome.exe|KingdomCome.exe|Executables (*.exe)|*.exe|All Files (*.*)|*.*";
            // Both builds use this filename, so the title has to say which one.
            dialog.Title = "Select KingdomCome.exe from the Modding Tools build (KCD2Mod\\Bin\\Win64ReleaseSteamLTO_DLL)";

            if (dialog.ShowDialog() == DialogResult.OK)
            {
                Settings.GamePath = dialog.FileName;

                InvokeAsync(StateHasChanged);
            }
        });

        thread.SetApartmentState(ApartmentState.STA);
        thread.Start();
        thread.Join();
    }
}
