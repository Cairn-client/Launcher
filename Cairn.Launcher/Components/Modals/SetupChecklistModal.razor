@using Cairn.Setup
@inherits ModalBase

@* the first-run checklist, also "Check setup". Drawn in the launcher's own modal frame;
   every step is decided by Cairn.Setup.SetupChecklist from the real state, never a saved flag. *@
@if (IsVisible)
{
    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box setup-box" @onclick:stopPropagation="true">

            <div class="modal-frame-top modal-frame-bg"></div>

            <div class="modal-content">
                <div class="modal-title">@(Ready ? "READY!" : SystemOnly ? "SYSTEM SETUP" : "BEFORE YOU PLAY")</div>

                @if (!Ready)
                {
                    <p class="setup-intro">@(SystemOnly ? "What your PC needs for any game. " : "What this game needs, on top of your PC. ")The launcher does each step for you, in the background. You can keep using your PC; this list updates by itself.</p>
                }

                @* Cairn: the steps are always shown, all good or not *@
                <ol class="setup-steps">
                    @foreach (var s in Shown)   @* Cairn: the closing "Ready!" row is not shown; the steps above say it all *@
                    {
                        <li class="setup-step setup-@s.Status.ToString().ToLowerInvariant()">
                            <span class="setup-icon">@Icon(s.Status)</span>
                            <div class="setup-body">
                                <div class="setup-step-title">@s.Title</div>
                                <div class="setup-detail">@s.Detail</div>
                                @if (s.Progress is double p && s.Status == StepStatus.Working)
                                {
                                    <div class="setup-bar"><div class="setup-bar-fill" style="width: @((p * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"></div></div>
                                }
                                @if (s.Status == StepStatus.NeedsYou && s.Action != StepAction.None && s.ActionLabel is not null)
                                {
                                    <button class="cairn-btn setup-action" disabled="@Busy" @onclick="() => OnAction.InvokeAsync(s.Action)">@s.ActionLabel</button>
                                }
                            </div>
                        </li>
                    }
                </ol>

                @if (Lines.Count > 0 && !Ready)
                {
                    <div class="setup-lines">
                        @foreach (var line in Lines)
                        {
                            <div>@line</div>
                        }
                    </div>
                }

                <div class="modal-actions">
                    <button class="cairn-btn" disabled="@Busy" @onclick="OnCheckAgain">CHECK AGAIN</button>
                    <button class="cairn-btn primary" @onclick="CloseModalAsync">CLOSE</button>
                </div>
            </div>

            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<StepView> Steps { get; set; } = Array.Empty<StepView>();
    [Parameter] public IReadOnlyList<string> Lines { get; set; } = Array.Empty<string>();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<StepAction> OnAction { get; set; }
    [Parameter] public EventCallback OnCheckAgain { get; set; }

    /// <summary>Only the steps that concern every game (Steam, the runtimes) when opened from Home or Help; all of them when a game is about to start.</summary>
    [Parameter] public bool SystemOnly { get; set; }

    private IEnumerable<StepView> Shown => Steps.Where(x => x.Id != StepId.Ready && (!SystemOnly || x.Id is StepId.Steam or StepId.VcRuntime));

    private bool Ready => Steps.Count > 0 && (SystemOnly ? Shown.Any() && Shown.All(x => x.Status == StepStatus.Done) : SetupChecklist.IsReady(Steps));

    private static string Icon(StepStatus s) => s switch
    {
        StepStatus.Done => "✅",
        StepStatus.Working => "⏳",
        StepStatus.NeedsYou => "❌",
        _ => "·",
    };
}
