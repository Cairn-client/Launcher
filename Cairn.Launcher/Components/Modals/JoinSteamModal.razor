@inherits ModalBase
@using Cairn.Launcher.Models

@* Join, "Through Steam": the host's code, or a Steam friend who is hosting. *@
@if (IsVisible)
{
    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box" @onclick:stopPropagation="true">

            <div class="modal-frame-top modal-frame-bg"></div>

            <div class="modal-content" style="text-align: left;">
                <div class="modal-title" style="text-align: center;">JOIN GAME</div>

                @* Cairn: the Steam friends who are hosting are looked for when this window opens; the code is only a backup *@
                <div class="cairn-input-group">
                    <label class="cairn-label" style="display: flex; align-items: center; justify-content: space-between;">
                        <span>Steam friends who are hosting</span>
                        <button class="cairn-btn" disabled="@Busy" @onclick="OnRefresh" style="padding: 4px 12px; font-size: 12px;">REFRESH</button>
                    </label>
                    @if (Busy && Friends is not { Count: > 0 })
                    {
                        <div class="cairn-hint">@BusyText</div>
                    }
                    @if (Friends is { Count: > 0 })
                    {
                        @foreach (var f in Friends)
                        {
                            <div class="cairn-input" style="margin-top: 6px; cursor: pointer; @(f.Code == Code ? "font-weight: bold;" : "")"
                                 @onclick="() => CodeChanged.InvokeAsync(f.Code)">
                                @f.Name <span style="opacity: 0.7;">(Cairn @f.Release)</span>
                            </div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(FriendsNote))
                    {
                        <div class="cairn-hint">@FriendsNote</div>
                    }
                </div>

                <div class="cairn-input-group">
                    <label class="cairn-label">Or a host's code (optional)</label>
                    <div style="display: flex; gap: 8px; align-items: stretch;">
                        <input class="cairn-input join-code-input"
                               type="@(showCode ? "text" : "password")"
                               placeholder="ABCD-EFG"
                               value="@Code"
                               style="font-size: 20px; letter-spacing: 3px; text-align: center; flex: 1;"
                               @oninput="e => CodeChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
                        <button type="button" class="code-icon" aria-label="@(showCode ? "Hide the code" : "Show the code")" title="@(showCode ? "Hide the code" : "Show the code")" @onclick="() => showCode = !showCode">
                            @if (showCode)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ResultMessage))
                {
                    <div class="cairn-hint" style="margin: 10px 0; @(ResultOk ? "" : "color: var(--cairn-warn);")">@ResultMessage</div>
                }

                <div class="modal-actions">
                    <button class="cairn-btn primary" disabled="@string.IsNullOrWhiteSpace(Code)" @onclick="OnJoin">JOIN</button>
                    <button class="cairn-btn" @onclick="CloseModalAsync">CLOSE</button>
                </div>
            </div>

            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public EventCallback<string> CodeChanged { get; set; }
    [Parameter] public string AppName { get; set; } = "";
    [Parameter] public List<SteamFriendData>? Friends { get; set; }
    [Parameter] public string FriendsNote { get; set; } = "";
    [Parameter] public string ResultMessage { get; set; } = "";
    [Parameter] public bool ResultOk { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string BusyText { get; set; } = "";
    [Parameter] public EventCallback OnJoin { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool showCode;

    protected override void OnParametersSet()
    {
        if (!IsVisible)
        {
            showCode = false;
        }
    }
}
