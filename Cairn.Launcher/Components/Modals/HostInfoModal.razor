@inherits ModalBase
@inject Microsoft.JSInterop.IJSRuntime JS
@using Cairn.Launcher.Models
@using Microsoft.JSInterop

@* Cairn: the Host window is START GAME and CLOSE. Friends find the host in their JOIN GAME list; the code is a backup, shown on
   request, and the host's addresses stay hidden unless Settings asks for them. "Also allow Steam" lives in Settings. *@
@if (IsVisible)
{
    <div class="modal-overlay @(isClosing ? "closing" : "")">
        <div class="modal-box" style="width: 760px;" @onclick:stopPropagation="true">

            <div class="modal-frame-top modal-frame-bg"></div>

            <div class="modal-content" style="text-align: center;">
                <div class="modal-title" style="text-align: center;">HOST A GAME</div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="cairn-hint" style="color: var(--cairn-warn); margin-bottom: 15px;">@ErrorMessage</div>
                }
                else if (RelayRunning)
                {
                    <div class="cairn-hint" style="margin-bottom: 10px;">
                        @(GameRunning ? "Your game is running. Your friends find you in their JOIN GAME list." : "Ready. Press START GAME; your friends find you in their JOIN GAME list.")
                    </div>

                    @if (AllowSteam)
                    {
                        @if (SteamState == "failed")
                        {
                            <div class="cairn-hint" style="color: var(--cairn-warn);">@SteamMessage</div>
                        }
                        else
                        {
                            @* the code card: always there, the code itself hidden until the eye is pressed (a stream or a shared screen never shows it by accident) *@
                            bool haveCode = !string.IsNullOrEmpty(SteamCode) && SteamState == "ready";
                            <div class="code-card">
                                <div class="code-head">
                                    <span class="code-label">Your code</span>
                                    <span class="code-state @(haveCode ? "ok" : "")">@(haveCode ? "Ready to share" : "Getting your code...")</span>
                                </div>
                                <div class="code-row">
                                    <div class="code-value @(haveCode && showCode ? "" : "masked")" aria-live="polite">@(!haveCode ? "..." : showCode ? SteamCode : new string('•', Math.Max(8, SteamCode!.Length)))</div>
                                    <button class="code-icon" disabled="@(!haveCode)" aria-label="@(showCode ? "Hide the code" : "Show the code")" title="@(showCode ? "Hide the code" : "Show the code")" @onclick="() => showCode = !showCode">
                                        @if (showCode)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        }
                                    </button>
                                    <button class="cairn-btn code-copy" disabled="@(!haveCode)" @onclick="CopyCode">@(copied ? "COPIED" : "COPY CODE")</button>
                                </div>
                                <dl class="code-details">
                                    <div><dt>How friends join</dt><dd>They find you in their JOIN GAME list. The code is the backup if you are not listed.</dd></div>
                                    <div><dt>Connection</dt><dd>Through Steam@(ShowAddress ? "" : "; your address stays hidden")</dd></div>
                                    <div><dt>Game</dt><dd>@(GameRunning ? "Running" : "Not started yet")</dd></div>
                                    <div><dt>Cairn</dt><dd>@Cairn.Launcher.Components.Shared.Globals.CairnVersion (your friend needs the same version)</dd></div>
                                </dl>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="cairn-hint">Steam is off for hosting (Settings). Friends can only join by your address.</div>
                    }

                    @if (!string.IsNullOrEmpty(RefusedNotice))
                    {
                        <div class="cairn-hint" style="color: var(--cairn-warn); margin-bottom: 10px;">@RefusedNotice</div>
                    }

                    @if (ShowAddress)
                    {
                        <div class="cairn-input-group">
                            <label class="cairn-label">Your address</label>
                            @if (Addresses.Count == 0)
                            {
                                <div class="cairn-hint">No network adapters found.</div>
                            }
                            else
                            {
                                @foreach (var addr in Addresses)
                                {
                                    <div class="cairn-input" style="margin-bottom: 6px; font-weight: bold;">@addr:@Port</div>
                                }
                            }
                            <div class="cairn-hint">Same Wi-Fi: any address works. Over the internet, use a VPN like Tailscale on both PCs, or forward port @Port (TCP).</div>
                        </div>
                    }
                }
                else
                {
                    <div class="cairn-hint">Starting the relay...</div>
                }

                <div class="modal-actions">
                    @if (RelayRunning && !GameRunning)
                    {
                        <button class="cairn-btn primary" @onclick="OnLaunchAsHost">START GAME</button>
                    }
                    <button class="cairn-btn" @onclick="CloseModalAsync">CLOSE</button>
                </div>
            </div>

            <div class="modal-frame-bottom modal-frame-bg"></div>
        </div>
    </div>
}

@code {
    [Parameter] public int Port { get; set; }
    [Parameter] public List<string> Addresses { get; set; } = new();
    [Parameter] public bool ShowAddress { get; set; }
    [Parameter] public bool GameRunning { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public bool RelayRunning { get; set; }
    [Parameter] public EventCallback OnLaunchAsHost { get; set; }

    [Parameter] public bool AllowSteam { get; set; }
    [Parameter] public string SteamState { get; set; } = "off";
    [Parameter] public string SteamMessage { get; set; } = "";
    [Parameter] public string? SteamCode { get; set; }
    [Parameter] public string RefusedNotice { get; set; } = "";

    private bool showCode;
    private bool copied;

    /// <summary>The code goes to the clipboard whether or not it is revealed.</summary>
    private async Task CopyCode()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", SteamCode ?? ""); copied = true; _ = Task.Delay(2000).ContinueWith(_ => { copied = false; return InvokeAsync(StateHasChanged); }); }
        catch (Exception) { copied = false; }
    }

    // the code is hidden again every time the window closes (a stream or a shared screen never shows it by accident)
    protected override void OnParametersSet() { if (!IsVisible) { showCode = false; copied = false; } }
}
