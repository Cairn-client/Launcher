@using Cairn.Launcher.Components.Shared
@using Cairn.Launcher.Models
@using Cairn.Setup
@* Your account, laid out like a Steam profile: a banner with your avatar, name and status, your numbers, recent activity as cards,
   your Steam favourites, and your friends who are online. *@
@{
    string avatar = Info?.Avatar is { Length: > 0 } full ? full : Avatar.Length > 0 ? $"https://avatars.steamstatic.com/{Avatar}_full.jpg" : "";
    string state = Info?.State is { Length: > 0 } s ? s : SteamName.Length > 0 ? "online" : "offline";
}
<div class="view profile-page">
    <header class="profile-banner" style="@(avatar.Length > 0 ? $"--banner: url('{avatar}');" : "")">
        <span class="profile-avatar @state">
            @if (avatar.Length > 0) { <img src="@avatar" alt="" /> }
            else { <span>@(SteamName.Length > 0 ? SteamName[..1].ToUpperInvariant() : "?")</span> }
        </span>
        <div class="profile-who">
            <h1>@(SteamName.Length > 0 ? SteamName : "Steam is not signed in")</h1>
            <span class="profile-status @state">@(Info?.StateMessage is { Length: > 0 } msg ? msg : SteamName.Length > 0 ? "Online" : "Start Steam and sign in: Cairn finds your friends through it.")</span>
            @if (Info is { } i && (i.RealName.Length > 0 || i.Location.Length > 0))
            {
                <span class="muted">@string.Join(" · ", new[] { i.RealName, i.Location }.Where(x => x.Length > 0))</span>
            }
            <span class="muted">@(Info?.MemberSince is { } since ? "Member of Steam since " + since.ToString("MMMM yyyy") + " · " : "")Cairn @Globals.CairnVersion</span>
        </div>
        <div class="profile-ids muted" title="Hover to show your Steam id">@if (SteamId.Length > 0) { <span>Steam id </span><span class="profile-id-value">@SteamId</span> }</div>
    </header>

    <div class="profile-stats">
        <div><b>@Sessions</b><span>@(Sessions == 1 ? "session" : "sessions")</span></div>
        <div><b>@Played</b><span>played on Cairn</span></div>
        <div><b>@ModsInstalled</b><span>@(ModsInstalled == 1 ? "mod installed" : "mods installed")</span></div>
    </div>

    <div class="profile-cols @(Info is { Summary.Length: > 0 } ? "" : "one")">
        <div class="profile-main">
            <section class="card">
                <div class="card-head"><h2>Recent activity</h2></div>
                @if (Rows.Count == 0)
                {
                    <p class="muted">Nothing played yet. Host or join a game and it shows up here.</p>
                }
                else
                {
                    <div class="recent-cards">
                        @foreach (var (game, s2) in Rows.Take(6))
                        {
                            <button class="recent-card" style="--art: url('@(game.BackgroundImage.Length > 0 ? game.BackgroundImage : game.PosterImage)');" @onclick="() => OnOpenGame.InvokeAsync(game.Id)">
                                <span class="recent-logo">@if (game.LogoImage.Length > 0) { <img src="@game.LogoImage" alt="" /> } else { <strong>@game.DisplayName</strong> }</span>
                                <span class="recent-line">@(s2.Minutes > 0 ? HomeLogic.Played(s2.Minutes) + " played" : s2.Sessions == 1 ? "1 session" : $"{s2.Sessions} sessions")</span>
                                <span class="recent-sub">@(s2.Role == "host" ? "Hosted" : s2.With.Length > 0 ? "Joined " + s2.With : "Joined") @HomeLogic.Ago(s2.LastUtc, DateTime.UtcNow)</span>
                            </button>
                        }
                    </div>
                }
            </section>

        </div>

        <div class="profile-side">
            @if (Info is { Summary.Length: > 0 } about)
            {
                <section class="card">
                    <div class="card-head"><h2>About</h2></div>
                    <p>@about.Summary</p>
                </section>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string SteamName { get; set; } = "";
    [Parameter] public string SteamId { get; set; } = "";
    [Parameter] public string Avatar { get; set; } = "";
    /// <summary>What the Steam profile page says (null until it has been read, or when the profile is private).</summary>
    [Parameter] public SteamProfileStatus.ProfileInfo? Info { get; set; }
    [Parameter] public int Sessions { get; set; }
    [Parameter] public string Played { get; set; } = "-";
    [Parameter] public int ModsInstalled { get; set; }
    /// <summary>Every game played from Cairn, the latest first.</summary>
    [Parameter] public IReadOnlyList<(GameProfile Game, RecentSession Session)> Rows { get; set; } = Array.Empty<(GameProfile, RecentSession)>();
    [Parameter] public EventCallback<string> OnOpenGame { get; set; }

}
