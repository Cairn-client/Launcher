@using Cairn.Launcher.Components.Shared
@using Cairn.Launcher.Models
@using Cairn.Setup
@* Your account, laid out like a Steam profile: a banner with your avatar, name and status, your numbers, recent activity as cards,
   your Steam favourites, and your friends who are online. *@
@{
    string avatar = Info?.Avatar is { Length: > 0 } full ? full : Avatar.Length > 0 ? $"https://avatars.steamstatic.com/{Avatar}_full.jpg" : "";
    string state = Info?.State is { Length: > 0 } s ? s : SteamName.Length > 0 ? "online" : "offline";
}
<div class="view profile-page">
    @if (SteamName.Length == 0)
    {
        @* no Steam account to show: say why (Steam missing, or not signed in) and offer the one thing that fixes it *@
        <header class="profile-banner signed-out">
            <span class="profile-avatar signed-out">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
            </span>
            <div class="profile-who">
                <span class="profile-kicker">@(SteamInstalled ? "Steam is installed" : "Steam not found")</span>
                <h1>@(SteamInstalled ? "Sign in to Steam" : "Get Steam to play with friends")</h1>
                <p class="profile-hint">@(SteamInstalled
                    ? "Start Steam and sign in: Cairn finds your friends through it, and your profile shows up here."
                    : "Cairn finds your friends and your games through Steam. Install it, sign in, and your profile shows up here.")</p>
                <div class="profile-actions">
                    <button class="cairn-btn primary" @onclick="OnSteamAction">@(SteamInstalled ? "Start Steam" : "Get Steam")</button>
                    <span class="muted">Cairn @Globals.CairnVersion</span>
                </div>
            </div>
        </header>
    }
    else
    {
        <header class="profile-banner" style="@(avatar.Length > 0 ? $"--banner: url('{avatar}');" : "")">
            <span class="profile-avatar @state">
                @if (avatar.Length > 0) { <img src="@avatar" alt="" /> }
                else { <span>@(SteamName[..1].ToUpperInvariant())</span> }
            </span>
            <div class="profile-who">
                <h1>@SteamName</h1>
                <span class="profile-status @state">@(Info?.StateMessage is { Length: > 0 } msg ? msg : "Online")</span>
                @if (Info is { } i && (i.RealName.Length > 0 || i.Location.Length > 0))
                {
                    <span class="muted">@string.Join(" · ", new[] { i.RealName, i.Location }.Where(x => x.Length > 0))</span>
                }
                <span class="muted">@(Info?.MemberSince is { } since ? "Member of Steam since " + since.ToString("MMMM yyyy") + " · " : "")Cairn @Globals.CairnVersion</span>
            </div>
            <div class="profile-ids muted" title="Hover to show your Steam id">@if (SteamId.Length > 0) { <span>Steam id </span><span class="profile-id-value">@SteamId</span> }</div>
        </header>
    }

    @if (Sessions > 0 || ModsInstalled > 0)
    {
        <div class="profile-stats">
            <div><b>@Sessions</b><span>@(Sessions == 1 ? "session" : "sessions")</span></div>
            <div><b>@Played</b><span>played on Cairn</span></div>
            <div><b>@ModsInstalled</b><span>@(ModsInstalled == 1 ? "mod installed" : "mods installed")</span></div>
        </div>
    }

    <div class="profile-cols one">
        <div class="profile-main">
            <section class="activity-panel">
                <header class="activity-head">
                    <span>Recent activity</span>
                    <span class="activity-total">@(Rows.Sum(r => r.Session.Minutes) > 0 ? HomeLogic.Played(Rows.Sum(r => r.Session.Minutes)) + " played on Cairn" : "")</span>
                </header>
                @if (Rows.Count == 0)
                {
                    <p class="muted activity-empty">Nothing played yet. Host or join a game and it shows up here.</p>
                }
                else
                {
                    @foreach (var (game, s2) in Rows.Take(8))
                    {
                        <article class="activity-item">
                            <div class="activity-top">
                                <button class="activity-art" style="--art: url('@(game.BackgroundImage.Length > 0 ? game.BackgroundImage : game.PosterImage)');" title="Open @game.DisplayName" @onclick="() => OnOpenGame.InvokeAsync(game.Id)">
                                    @if (game.LogoImage.Length > 0) { <img src="@game.LogoImage" alt="" /> } else { <strong>@game.DisplayName</strong> }
                                </button>
                                <span class="activity-name">@game.DisplayName</span>
                                <span class="activity-meta">
                                    <span>@(s2.Minutes > 0 ? HomeLogic.Played(s2.Minutes) + " on record" : s2.Sessions == 1 ? "1 session" : $"{s2.Sessions} sessions")</span>
                                    <span class="muted">last played on @s2.LastUtc.ToLocalTime().ToString("d MMM")</span>
                                </span>
                            </div>
                        </article>
                    }
                }
            </section>
        </div>

        <div class="profile-side wide">
            @if (Info is { Summary.Length: > 0 } about)
            {
                <section class="card">
                    <div class="card-head"><h2>About</h2></div>
                    <p>@about.Summary</p>
                </section>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string SteamName { get; set; } = "";
    [Parameter] public string SteamId { get; set; } = "";
    [Parameter] public string Avatar { get; set; } = "";
    /// <summary>Whether Steam is on this PC at all (when nobody is signed in, the page says which of the two to fix).</summary>
    [Parameter] public bool SteamInstalled { get; set; }
    /// <summary>Starts Steam, or opens its download page when it is not installed.</summary>
    [Parameter] public EventCallback OnSteamAction { get; set; }
    /// <summary>What the Steam profile page says (null until it has been read, or when the profile is private).</summary>
    [Parameter] public SteamProfileStatus.ProfileInfo? Info { get; set; }
    [Parameter] public int Sessions { get; set; }
    [Parameter] public string Played { get; set; } = "-";
    [Parameter] public int ModsInstalled { get; set; }
    /// <summary>Every game played from Cairn, the latest first.</summary>
    [Parameter] public IReadOnlyList<(GameProfile Game, RecentSession Session)> Rows { get; set; } = Array.Empty<(GameProfile, RecentSession)>();
    [Parameter] public EventCallback<string> OnOpenGame { get; set; }

}
