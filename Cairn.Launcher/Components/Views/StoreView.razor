@using Cairn.Launcher.Models

@* The Store: every game Cairn has a mod for (or will have), to add to your library. Nothing is downloaded here: adding a game only puts it in the Library,
   where its mod is downloaded when you want it. *@
<div class="view store">
    <header class="view-head">
        <h1>Store</h1>
        <p class="lead">Add the games you play to your library. Nothing is downloaded until you ask for the mod.</p>
    </header>

    <div class="store-bar">
        <input class="cairn-input" placeholder="Search games" @bind="query" @bind:event="oninput" />
        <div class="filter-chips" role="group" aria-label="Show">
            @foreach (var (id, label) in Filters)
            {
                string key = id;
                <button class="filter-chip @(filter == key ? "on" : "")" aria-pressed="@(filter == key ? "true" : "false")" @onclick="() => filter = key">@label</button>
            }
        </div>
    </div>

    @if (Chosen is { } g)
    {
        bool owned = InLibrary(g.Id);
        <section class="store-detail" style="@(g.Accent.Length > 0 ? $"--cairn-gold: {g.Accent};" : "")">
            <div class="store-hero" style="background-image: url('@(g.BackgroundImage.Length > 0 ? g.BackgroundImage : g.HeroImage)');">
                <div class="store-hero-shade"></div>
                <button class="store-back" @onclick="() => chosen = null">&larr; All games</button>
                <div class="store-hero-body">
                    @if (g.LogoImage.Length > 0) { <img class="store-logo" src="@g.LogoImage" alt="@g.DisplayName" /> } else { <h2>@g.DisplayName</h2> }
                </div>
            </div>
            <div class="store-detail-body">
                <p class="store-desc">@(g.Description.Length > 0 ? g.Description : "Multiplayer for this game is on its way.")</p>
                <dl class="details stack store-facts">
                    @if (g.Developer.Length > 0) { <div><dt>Developer</dt><dd>@g.Developer</dd></div> }
                    @if (g.Franchise.Length > 0) { <div><dt>Franchise</dt><dd>@g.Franchise</dd></div> }
                    <div><dt>Multiplayer</dt><dd>@(g.IsSupported ? "Playable now" : "Coming soon")</dd></div>
                    <div><dt>On this PC</dt><dd>@(IsOnPc(g) ? "Found" : "Not found")</dd></div>
                </dl>
                <div class="store-actions">
                    @if (owned)
                    {
                        <button class="cairn-btn primary" @onclick="() => OnOpen.InvokeAsync(g.Id)">OPEN IN LIBRARY</button>
                        <button class="cairn-btn" @onclick="() => OnRemove.InvokeAsync(g.Id)">REMOVE FROM LIBRARY</button>
                    }
                    else
                    {
                        <button class="cairn-btn primary" @onclick="() => OnAdd.InvokeAsync(g.Id)">ADD TO LIBRARY</button>
                    }
                    @if (!g.IsSupported) { <span class="muted">Adding a game that is not playable yet keeps it in your library until its mod is out.</span> }
                </div>
            </div>
        </section>
    }
    else
    {
        var shown = Visible();
        @if (shown.Count == 0)
        {
            <p class="muted store-none">No game fits. Try another word or filter.</p>
        }
        else
        {
            <div class="store-grid">
                @foreach (var card in shown)
                {
                    bool inLib = InLibrary(card.Id);
                    <div class="store-card">
                        <button class="poster" title="@card.DisplayName" @onclick="() => chosen = card.Id">
                            <span class="poster-art" style="background-image: url('@(card.PosterImage.Length > 0 ? card.PosterImage : card.BackgroundImage)');"></span>
                            <span class="poster-shade"></span>
                            @if (inLib) { <span class="poster-flag">In your library</span> }
                            else if (IsOnPc(card)) { <span class="poster-flag">On this PC</span> }
                            <span class="poster-name">@card.DisplayName</span>
                            <span class="poster-sub">@(card.IsSupported ? (card.Developer.Length > 0 ? card.Developer : "Playable now") : "Coming soon")</span>
                        </button>
                        <button class="cairn-btn store-add @(inLib ? "" : "primary")" @onclick="() => OnToggle(card)">@(inLib ? "IN LIBRARY" : "ADD")</button>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<GameProfile> Games { get; set; } = Array.Empty<GameProfile>();
    [Parameter] public Func<string, bool> InLibrary { get; set; } = _ => false;
    [Parameter] public Func<GameProfile, bool> IsOnPc { get; set; } = _ => false;
    /// <summary>A game to show in full when the Store opens (picked from search or Home).</summary>
    [Parameter] public string? Focus { get; set; }
    [Parameter] public EventCallback<string> OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnRemove { get; set; }
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    private string query = "";
    private string filter = "all";
    private string? chosen;
    private string? lastFocus;

    private static readonly (string Id, string Label)[] Filters =
    {
        ("all", "All"), ("playable", "Playable now"), ("soon", "Coming soon"), ("pc", "On this PC"), ("mine", "In my library"), ("new", "Not added"),
    };

    protected override void OnParametersSet()
    {
        if (Focus is { Length: > 0 } f && f != lastFocus) { chosen = f; lastFocus = f; }
        else if (Focus == "" && lastFocus != "") { chosen = null; lastFocus = ""; }   // the Store button pressed again: back to the list
        else if (Focus is null) lastFocus = null;
    }

    private GameProfile? Chosen => chosen is null ? null : Games.FirstOrDefault(g => string.Equals(g.Id, chosen, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<GameProfile> Visible()
    {
        string q = query.Trim();
        return Games
            .Where(g => q.Length == 0 || g.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase) || g.Developer.Contains(q, StringComparison.OrdinalIgnoreCase) || g.Franchise.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(g => filter switch
            {
                "playable" => g.IsSupported,
                "soon" => !g.IsSupported,
                "pc" => IsOnPc(g),
                "mine" => InLibrary(g.Id),
                "new" => !InLibrary(g.Id),
                _ => true,
            })
            .OrderByDescending(g => g.IsSupported).ThenBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private Task OnToggle(GameProfile g) => InLibrary(g.Id) ? OnRemove.InvokeAsync(g.Id) : OnAdd.InvokeAsync(g.Id);
}
