@using Cairn.Launcher.Models

@* The Store: every game Cairn has a mod for (or will have), to add to your library. Nothing is downloaded here: adding a game only puts it in the Library,
   where its mod is downloaded when you want it. The game being looked at belongs to the launcher (Chosen), so the back button of the mouse can return to it. *@
<div class="view store">
    @if (Current is { } g)
    {
        bool owned = InLibrary(g.Id);
        var groups = GameFeatures.For(g.Id);
        <button class="store-back" @onclick="() => OnChoose.InvokeAsync(null)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"/></svg>
            <span>Back to the store</span>
        </button>
        <section class="store-detail" style="@(g.Accent.Length > 0 ? $"--cairn-gold: {g.Accent};" : "")">
            <div class="store-hero" style="background-image: url('@(g.BackgroundImage.Length > 0 ? g.BackgroundImage : g.HeroImage)');">
                <div class="store-hero-shade"></div>
                <div class="store-hero-body">
                    @if (g.LogoImage.Length > 0) { <img class="store-logo" src="@g.LogoImage" alt="@g.DisplayName" /> } else { <h2>@g.DisplayName</h2> }
                    <div class="store-hero-actions">
                        @if (owned)
                        {
                            <button class="cairn-btn primary" @onclick="() => OnOpen.InvokeAsync(g.Id)">OPEN IN LIBRARY</button>
                            <button class="cairn-btn" @onclick="() => OnRemove.InvokeAsync(g.Id)">REMOVE</button>
                        }
                        else
                        {
                            <button class="cairn-btn primary" @onclick="() => OnAdd.InvokeAsync(g.Id)">ADD TO LIBRARY</button>
                        }
                    </div>
                </div>
            </div>
            <div class="store-detail-body">
                <div class="store-main">
                    <p class="store-desc">@(g.Description.Length > 0 ? g.Description : "Multiplayer for this game is on its way.")</p>
                    @if (!g.IsSupported) { <p class="muted">You can add it now: it stays in your library until its mod is out.</p> }

                    @if (groups.Count > 0)
                    {
                        <h3 class="store-h">What the mod does</h3>
                        @foreach (var group in groups)
                        {
                            <div class="store-feature-group">
                                <div class="store-feature-title">@group.Title</div>
                                @foreach (var f in group.Items)
                                {
                                    <div class="store-feature">
                                        <span class="store-feature-dot @StatusClass(f.Status)"></span>
                                        <div class="store-feature-text">
                                            <span class="store-feature-name">@f.Name</span>
                                            <span class="store-feature-detail">@f.Detail</span>
                                        </div>
                                        <span class="store-pill @StatusClass(f.Status)">@GameFeatures.Label(f.Status)</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <aside class="store-side">
                    <div class="store-fact"><span>Developer</span><b>@(g.Developer.Length > 0 ? g.Developer : "-")</b></div>
                    <div class="store-fact"><span>Franchise</span><b>@(g.Franchise.Length > 0 ? g.Franchise : "-")</b></div>
                    <div class="store-fact"><span>Multiplayer</span><b class="@(g.IsSupported ? "good" : "")">@(g.IsSupported ? "Playable now" : "Coming soon")</b></div>
                    <div class="store-fact"><span>On this PC</span><b class="@(IsOnPc(g) ? "good" : "")">@(IsOnPc(g) ? "Found" : "Not found")</b></div>
                    <div class="store-fact"><span>In your library</span><b class="@(owned ? "good" : "")">@(owned ? "Yes" : "No")</b></div>
                </aside>
            </div>
        </section>
    }
    else
    {
        <header class="view-head">
            <h1>Store</h1>
            <p class="lead">Add the games you play to your library. Nothing is downloaded until you ask for the mod.</p>
        </header>

        <div class="store-bar">
            <label class="store-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.5" y2="16.5"/></svg>
                <input placeholder="Search games" @bind="query" @bind:event="oninput" />
            </label>
            <div class="store-chips" role="group" aria-label="Show">
                @foreach (var (id, label) in Filters)
                {
                    string key = id;
                    <button class="store-chip @(filter == key ? "on" : "")" aria-pressed="@(filter == key ? "true" : "false")" @onclick="() => filter = key">@label</button>
                }
            </div>
        </div>

        var shown = Visible();
        @if (shown.Count == 0)
        {
            <p class="muted store-none">No game fits. Try another word or filter.</p>
        }
        else
        {
            @* with no word and no filter the games are in two shelves; otherwise it is one grid *@
            bool shelves = query.Trim().Length == 0 && filter == "all";
            var playable = shown.Where(x => x.IsSupported).ToList();
            var soon = shown.Where(x => !x.IsSupported).ToList();
            @if (shelves)
            {
                @if (playable.Count > 0)
                {
                    <h2 class="store-shelf">Playable now <span>@playable.Count</span></h2>
                    @Grid(playable)
                }
                @if (soon.Count > 0)
                {
                    <h2 class="store-shelf">Coming soon <span>@soon.Count</span></h2>
                    @Grid(soon)
                }
            }
            else
            {
                @Grid(shown)
            }
        }
    }
</div>

@code {
    private RenderFragment Grid(IReadOnlyList<GameProfile> list) => @<div class="store-grid">
        @foreach (var card in list)
        {
            bool inLib = InLibrary(card.Id);
            <div class="store-card @(inLib ? "owned" : "")">
                <button class="store-poster" title="@card.DisplayName" @onclick="() => OnChoose.InvokeAsync(card.Id)">
                    <span class="store-art" style="background-image: url('@(card.PosterImage.Length > 0 ? card.PosterImage : card.BackgroundImage)');"></span>
                    @if (IsOnPc(card)) { <span class="store-tag">On this PC</span> }
                    @if (inLib) { <span class="store-check" title="In your library"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg></span> }
                </button>
                <div class="store-meta">
                    <span class="store-name">@card.DisplayName</span>
                    <span class="store-dev">@(card.IsSupported ? (card.Developer.Length > 0 ? card.Developer : "Playable now") : "Coming soon")</span>
                </div>
                <button class="store-add @(inLib ? "in" : "")" @onclick="() => OnToggle(card)">
                    @if (inLib) { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg> }
                    else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> }
                    <span>@(inLib ? "In your library" : "Add to library")</span>
                </button>
            </div>
        }
    </div>;

    [Parameter] public IReadOnlyList<GameProfile> Games { get; set; } = Array.Empty<GameProfile>();
    [Parameter] public Func<string, bool> InLibrary { get; set; } = _ => false;
    [Parameter] public Func<GameProfile, bool> IsOnPc { get; set; } = _ => false;
    /// <summary>The game shown in full (null: the list). Kept by the launcher, so going back returns to it.</summary>
    [Parameter] public string? Chosen { get; set; }
    [Parameter] public EventCallback<string?> OnChoose { get; set; }
    [Parameter] public EventCallback<string> OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnRemove { get; set; }
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    private string query = "";
    private string filter = "all";

    private static readonly (string Id, string Label)[] Filters =
    {
        ("all", "All"), ("playable", "Playable now"), ("soon", "Coming soon"), ("pc", "On this PC"), ("mine", "In my library"), ("new", "Not added"),
    };

    private GameProfile? Current => string.IsNullOrEmpty(Chosen) ? null : Games.FirstOrDefault(g => string.Equals(g.Id, Chosen, StringComparison.OrdinalIgnoreCase));

    private static string StatusClass(FeatureStatus s) => s switch { FeatureStatus.Ready => "ready", FeatureStatus.InTest => "test", _ => "planned" };

    private IReadOnlyList<GameProfile> Visible()
    {
        string q = query.Trim();
        return Games
            .Where(g => q.Length == 0 || g.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase) || g.Developer.Contains(q, StringComparison.OrdinalIgnoreCase) || g.Franchise.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(g => filter switch
            {
                "playable" => g.IsSupported,
                "soon" => !g.IsSupported,
                "pc" => IsOnPc(g),
                "mine" => InLibrary(g.Id),
                "new" => !InLibrary(g.Id),
                _ => true,
            })
            .OrderByDescending(g => g.IsSupported).ThenBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private Task OnToggle(GameProfile g) => InLibrary(g.Id) ? OnRemove.InvokeAsync(g.Id) : OnAdd.InvokeAsync(g.Id);
}
