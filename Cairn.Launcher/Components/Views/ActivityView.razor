@using Cairn.Launcher.Models
@* What you played from this launcher: the totals, and each game with how you last played it, how often and for how long. *@
<div class="view">
    <header class="view-head">
        <h1>Activity</h1>
        <p class="lead">The sessions you started from Cairn, game by game.</p>
    </header>

    @if (Rows.Count == 0)
    {
        <section class="card">
            <p class="muted">Nothing played yet. Host or join a game and it shows up here.</p>
            <button class="cairn-btn" @onclick="OnOpenLibrary">OPEN THE LIBRARY</button>
        </section>
    }
    else
    {
        <section class="card now">
            <div class="facts">
                <div><span class="k">Sessions</span><span class="v">@Rows.Sum(r => r.Session.Sessions)</span></div>
                <div><span class="k">Time played</span><span class="v">@(TotalMinutes > 0 ? HomeLogic.Played(TotalMinutes) : "-")</span></div>
                <div><span class="k">Games</span><span class="v">@Rows.Count</span></div>
                <div><span class="k">Most played</span><span class="v">@Most</span></div>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><h2>By game</h2></div>
            <ul class="activity">
                @foreach (var (game, s) in Rows)
                {
                    <li>
                        <button class="activity-row" @onclick="() => OnOpenGame.InvokeAsync(game.Id)">
                            <span class="activity-logo">@if (game.LogoImage.Length > 0) { <img src="@game.LogoImage" alt="" /> }</span>
                            <span class="activity-main">
                                <strong>@game.DisplayName</strong>
                                <span class="muted">@(s.Role == "host" ? "You hosted" : s.With.Length > 0 ? "You joined " + s.With : "You joined") · @HomeLogic.Ago(s.LastUtc, DateTime.UtcNow)</span>
                            </span>
                            <span class="activity-stat"><b>@s.Sessions</b><span class="muted">@(s.Sessions == 1 ? "session" : "sessions")</span></span>
                            <span class="activity-stat"><b>@(s.Minutes > 0 ? HomeLogic.Played(s.Minutes) : "-")</b><span class="muted">played</span></span>
                        </button>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<(GameProfile Game, RecentSession Session)> Rows { get; set; } = Array.Empty<(GameProfile, RecentSession)>();
    [Parameter] public EventCallback<string> OnOpenGame { get; set; }
    [Parameter] public EventCallback OnOpenLibrary { get; set; }

    private int TotalMinutes => Rows.Sum(r => r.Session.Minutes);
    private string Most => Rows.OrderByDescending(r => r.Session.Minutes).ThenByDescending(r => r.Session.Sessions).First().Game.DisplayName;
}
