@using Cairn.Launcher.Models

@* Ctrl+K: type a title, a studio or a franchise, press Enter to open the game. *@
@if (IsVisible)
{
    var found = Results();
    <div class="qs-backdrop" @onclick="OnClose">
        <div class="qs-box" role="dialog" aria-label="Quick search" @onclick:stopPropagation="true">
            <input @ref="input" class="qs-input" type="search" placeholder="Search games (title, studio, franchise)" aria-label="Search games"
                   @bind="query" @bind:event="oninput" @onkeydown="OnKey" />
            <ul class="qs-list" role="listbox">
                @for (int i = 0; i < found.Count; i++)
                {
                    var g = found[i];
                    int row = i;
                    <li>
                        <button class="qs-item @(i == selected ? "on" : "")" role="option" aria-selected="@(i == selected ? "true" : "false")"
                                @onclick="() => OnPick.InvokeAsync(g.Id)" @onmouseenter="() => selected = row">
                            <span class="qs-logo">@if (g.LogoImage.Length > 0) { <img src="@g.LogoImage" alt="" /> }</span>
                            <span class="qs-text">
                                <span class="qs-name">@g.DisplayName@if (Favorites.Contains(g.Id)) { <span class="fav-mark">&#9829;</span> }</span>
                                <span class="qs-sub">@(g.Developer.Length > 0 ? g.Developer : "")@(OnPc?.Invoke(g) == true ? " · On this PC" : "")@(g.IsSupported ? "" : " · Coming soon")</span>
                            </span>
                        </button>
                    </li>
                }
                @if (found.Count == 0)
                {
                    <li class="qs-empty">No game matches "@query".</li>
                }
            </ul>
            <div class="qs-hint">Enter to open · Up and Down to move · Esc to close</div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public IReadOnlyList<GameProfile> Games { get; set; } = Array.Empty<GameProfile>();
    [Parameter] public Func<GameProfile, bool>? OnPc { get; set; }
    [Parameter] public ISet<string> Favorites { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string queryText = "";
    private string query { get => queryText; set { queryText = value; selected = 0; } }
    private int selected;
    private bool wasVisible;
    private Microsoft.AspNetCore.Components.ElementReference input;

    private List<GameProfile> Results() =>
        Games.Where(g => GameListView.Matches(g, query.Trim()))
             .OrderByDescending(g => Favorites.Contains(g.Id)).ThenByDescending(g => g.IsSupported)
             .ThenBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).Take(8).ToList();

    private async Task OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        var found = Results();
        if (e.Key == "ArrowDown") selected = Math.Min(found.Count - 1, selected + 1);
        else if (e.Key == "ArrowUp") selected = Math.Max(0, selected - 1);
        else if (e.Key == "Enter" && found.Count > 0) await OnPick.InvokeAsync(found[Math.Min(selected, found.Count - 1)].Id);
    }

    protected override void OnParametersSet()
    {
        if (!IsVisible) { queryText = ""; selected = 0; }   // it opens empty every time
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !wasVisible)
        {
            try { await input.FocusAsync(); } catch (Exception) { /* focus is a convenience */ }
        }
        wasVisible = IsVisible;
    }
}
