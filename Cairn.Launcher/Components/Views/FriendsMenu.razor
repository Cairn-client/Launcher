@using Cairn.Launcher.Models
@* Your Steam friends in a menu beside your account: the button shows how many are online, the panel lists everyone with a search box.
   A friend who is hosting has Join; while you host, a friend on Cairn has Invite. *@
<div class="friends-menu">
    <button class="friends-btn @(open ? "active" : "")" aria-haspopup="true" aria-expanded="@open" title="Your Steam friends" @onclick="Toggle">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zM8 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5C15 14.2 10.3 13 8 13zm8 0c-.3 0-.6 0-1 .1 1.2.8 2 1.9 2 3.4V19h6v-2.5c0-2.3-4.7-3.5-7-3.5z"></path></svg>
        <span>Friends</span>
        @if (Online > 0) { <span class="friends-count">@Online</span> }
    </button>

    @if (open)
    {
        <div class="menu-backdrop" @onclick="Close"></div>
        <div class="friends-panel" role="menu" aria-label="Friends">
            <div class="friends-panel-head">
                <input class="cairn-input" placeholder="Search friends" @bind="query" @bind:event="oninput" />
                <span class="muted">@Online of @Friends.Count online</span>
            </div>
            @if (!Loaded)
            {
                <div class="tile-loading" role="status" aria-label="Asking Steam"><span class="spinner"></span></div>
            }
            else if (Friends.Count == 0)
            {
                <p class="muted friends-empty">No Steam friends were found. Make sure Steam is installed and you are signed in to it.</p>
            }
            else if (Shown().Count == 0)
            {
                <p class="muted friends-empty">No friend matches.</p>
            }
            else
            {
                <ul class="friends-list">
                    @foreach (var f in Shown())
                    {
                        <FriendRow Friend="f" Hosting="HostingAs(f)" Cairn="OnCairn(f)" CanInvite="CanInvite" Invited="Invited.Contains(f.Id)" OnJoin="JoinAsync" OnInvite="OnInvite" />
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SteamFriendRow> Friends { get; set; } = Array.Empty<SteamFriendRow>();
    [Parameter] public bool Loaded { get; set; }
    [Parameter] public Func<SteamFriendRow, SteamFriendData?> HostingAs { get; set; } = _ => null;
    [Parameter] public Func<SteamFriendRow, Cairn.Wire.PresenceFriend?> OnCairn { get; set; } = _ => null;
    [Parameter] public bool CanInvite { get; set; }
    [Parameter] public ISet<string> Invited { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<SteamFriendData> OnJoin { get; set; }
    [Parameter] public EventCallback<SteamFriendRow> OnInvite { get; set; }

    private bool open;
    private string query = "";

    private int Online => Friends.Count(f => f.State is "online" or "in-game" || OnCairn(f) is { Online: true });

    private void Toggle() => open = !open;
    private void Close() { open = false; query = ""; }

    private async Task JoinAsync(SteamFriendData friend)
    {
        Close();
        await OnJoin.InvokeAsync(friend);
    }

    // who is up first (hosting, then in a game, then online), the rest by name
    private IReadOnlyList<SteamFriendRow> Shown() => Friends
        .Where(f => query.Length == 0 || f.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(f => HostingAs(f) is not null ? 0 : f.State == "in-game" ? 1 : f.State == "online" || OnCairn(f) is { Online: true } ? 2 : 3)
        .ThenBy(f => f.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
}
