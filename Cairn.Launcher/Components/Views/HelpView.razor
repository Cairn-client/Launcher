@using Cairn.Launcher.Components.Shared

@* Help and About in one page. The credit to the projects Cairn continues and the disclaimer stay (GPLv3 section 7, AUTHORS.md). *@
<div class="view">
    <header class="view-head">
        <h1>Help</h1>
        <p class="lead">Get unstuck, report a problem, and find out who made what.</p>
    </header>

    @if (Notices.Count > 0)
    {
        <section class="card">
            <div class="card-head"><h2>Known issues and news</h2></div>
            <ul class="list">
                @foreach (var n in Notices)
                {
                    <li><strong>@n.Title</strong>@(n.Kind == Cairn.Setup.Notice.KnownIssue ? " (known issue)" : "") @n.Text</li>
                }
            </ul>
        </section>
    }

    <div class="columns">
        <section class="card">
            <div class="card-head"><h2>Having trouble?</h2></div>
            <ul class="list">
                <li><strong>Check your setup.</strong> The checklist finds what is missing (Steam, the Modding Tools, the mod) and fixes most of it.
                    <button class="link" @onclick="OnOpenSetup">Open the checklist</button></li>
                <li><strong>Mods.</strong> Each game's mod is downloaded from its page in the Library.
                    <button class="link" @onclick="OnOpenLibrary">Go to the Library</button></li>
                <li><strong>Welcome tour.</strong> A quick walk through Cairn.
                    <button class="link" @onclick="OnReplayTour">Replay the tour</button></li>
                <li><strong>Send the logs.</strong> Settings has a button that saves them in one zip; attach it to your report.
                    <button class="link" @onclick="OnOpenSettings">Open Settings</button></li>
            </ul>
            <div class="row-actions">
                <button class="cairn-btn primary" @onclick="@(() => UrlLauncher.Open(IssueUrl))">REPORT A BUG</button>
                <button class="cairn-btn" @onclick="@(() => UrlLauncher.Open(RepoUrl))">OPEN THE REPOSITORY</button>
            </div>
        </section>

        <section class="card">
            <div class="card-head"><h2>Keyboard</h2></div>
            <dl class="keys">
                <div><dt><kbd>F10</kbd></dt><dd>Open or close Settings</dd></div>
                <div><dt><kbd>F5</kbd></dt><dd>Refresh</dd></div>
                <div><dt><kbd>Esc</kbd></dt><dd>Close a window, or leave Cairn</dd></div>
            </dl>
            <div class="card-head" style="margin-top: 22px;"><h2>In the game</h2></div>
            <dl class="keys">
                <div><dt><kbd>Insert</kbd></dt><dd>Open or close the mod menu</dd></div>
                <div><dt><kbd class="key-arrow" title="Up" aria-label="Up">&#8593;</kbd> <kbd class="key-arrow" title="Down" aria-label="Down">&#8595;</kbd></dt><dd>Choose an item</dd></div>
                <div><dt><kbd class="key-arrow" title="Left" aria-label="Left">&#8592;</kbd> <kbd class="key-arrow" title="Right" aria-label="Right">&#8594;</kbd></dt><dd>Change the chosen value</dd></div>
                <div><dt><kbd>Enter</kbd></dt><dd>Do the chosen action</dd></div>
                <div><dt><kbd>Esc</kbd></dt><dd>Close the mod menu</dd></div>
            </dl>
        </section>
    </div>

    <section class="card">
        <div class="card-head"><h2>About Cairn Client</h2><span class="muted">Version @Globals.CairnVersion</span></div>
        <p>
            Cairn Client is a multiplayer platform for single-player games. One player hosts, a friend joins through Steam,
            and you share the same world.
        </p>
        <p class="muted">
            Cairn Client is a modified version, derived from Kingdom Come: Together by DeepFriedDepp, which continues
            marczukmichal/kcd2-multiplayer; their authors keep the copyright on their code. It is free software under the
            GNU General Public License version 3 (see LICENSE and AUTHORS.md for the complete list of contributors).
        </p>
        <p class="muted">
            Every game shown here, its assets and its artwork belong to its studio and publisher. Cairn Client is unofficial and free,
            and is not affiliated with or endorsed by any of them.
        </p>
    </section>
</div>

@code {
    public const string RepoUrl = "https://github.com/Cairn-client/launcher";
    private const string IssueUrl = RepoUrl + "/issues/new";

    [Parameter] public IReadOnlyList<Cairn.Setup.Notice> Notices { get; set; } = Array.Empty<Cairn.Setup.Notice>();
    [Parameter] public EventCallback OnOpenSetup { get; set; }
    [Parameter] public EventCallback OnReplayTour { get; set; }
    [Parameter] public EventCallback OnOpenLibrary { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
}
