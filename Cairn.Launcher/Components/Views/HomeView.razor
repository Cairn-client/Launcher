@implements IDisposable
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using Cairn.Launcher.Models
@using Cairn.Launcher.Components.Shared

@* The landing page, like a game launcher's: an update notice when there is one, a slideshow of the games Cairn covers, then where you
   left off, who is hosting, your mods, and shelves of posters. Opening a game goes to its page in the Library. *@
<div class="home">

    @if (UpdateTag is not null)
    {
        <div class="update-banner" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="7 11 12 16 17 11"/><path d="M5 21h14"/></svg>
            <div class="update-text">
                <strong>Cairn Client @UpdateTag is available.</strong>
                @if (UpdateNotes.Count > 0) { <span>@UpdateNotes[0]@(UpdateNotes.Count > 1 ? $" and {UpdateNotes.Count - 1} more" : "")</span> }
                <span class="muted">Both players need the same version to play together.</span>
            </div>
            <button class="update-btn" disabled="@UpdateBusy" @onclick="OnUpdate">@(UpdateBusy ? "Updating..." : "Update now")</button>
        </div>
    }

    @foreach (var n in Notices)
    {
        <div class="update-banner notice @(n.Kind == Cairn.Setup.Notice.KnownIssue ? "issue" : "news")" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @if (n.Kind == Cairn.Setup.Notice.KnownIssue) { <circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12.5"/><line x1="12" y1="16" x2="12.01" y2="16"/> }
                else { <path d="M4 5h16v11H8l-4 4z"/> }
            </svg>
            <div class="update-text">
                <strong>@n.Title</strong>
                @if (n.Text.Length > 0) { <span>@n.Text</span> }
            </div>
            <button class="update-btn quiet" title="Hide this message (it stays under Help)" @onclick="() => OnDismissNotice.InvokeAsync(n.Id)">Hide</button>
        </div>
    }

    @if (Slides.Count > 0)
    {
        <section class="showcase" tabindex="0"
                 @onkeydown="OnShowcaseKey"
                 aria-roledescription="carousel" aria-label="Games (use the left and right arrow keys)">
            @for (int i = 0; i < Slides.Count; i++)
            {
                var g = Slides[i];
                bool active = i == index;
                <article class="slide @(active ? "active" : "")" aria-hidden="@(active ? "false" : "true")">
                    <div class="slide-art" style="background-image: url('@ArtFor(g, active)');"></div>
                    <div class="slide-shade"></div>
                    <div class="slide-body">
                        @if (g.LogoImage.Length > 0)
                        {
                            <img class="slide-logo" src="@g.LogoImage" alt="@g.DisplayName" />
                        }
                        else
                        {
                            <h1 class="slide-title">@g.DisplayName</h1>
                        }
                        <p class="slide-desc">@g.Description</p>
                        <button class="slide-cta" tabindex="@(active ? 0 : -1)" @onclick="() => OnOpenGame.InvokeAsync(g.Id)">View game</button>
                    </div>
                </article>
            }

            <button class="arrow left" aria-label="Previous game" @onclick="Previous">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"/></svg>
            </button>
            <button class="arrow right" aria-label="Next game" @onclick="Next">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
            </button>

            <div class="dots" role="tablist">
                @for (int i = 0; i < Slides.Count; i++)
                {
                    int target = i;
                    bool active = i == index;
                    bool passed = i < index;
                    <button class="dot @(active ? "on" : "") @(passed ? "passed" : "")" role="tab"
                            aria-label="@Slides[i].DisplayName" aria-selected="@(active ? "true" : "false")"
                            @onclick="() => GoTo(target)">
                        <span class="dot-track">
                            @if (active)
                            {
                                <span class="dot-fill active-fill" @key="slideCycle"></span>
                            }
                            else
                            {
                                <span class="dot-fill @(passed ? "full" : "")"></span>
                            }
                        </span>
                    </button>
                }
            </div>
        </section>
    }

    <div class="home-body">

        <div class="dash">
            @* Continue: where you left off *@
            <section class="tile">
                <h2>Continue</h2>
                @if (RecentGame is { } rg && Last is { } last)
                {
                    <button class="continue" style="--continue-bg: url('@(rg.BackgroundImage.Length > 0 ? rg.BackgroundImage : rg.PosterImage)');" @onclick="() => OnOpenGame.InvokeAsync(rg.Id)">
                        <span class="continue-art" style="background-image: url('@(rg.PosterImage.Length > 0 ? rg.PosterImage : rg.BackgroundImage)');"></span>
                        <span class="continue-text">
                            <strong>@rg.DisplayName</strong>
                            <span>@(last.Role == "host" ? "You hosted" : last.With.Length > 0 ? "You joined " + last.With : "You joined") · @HomeLogic.Ago(last.LastUtc, DateTime.UtcNow)</span>
                            <span class="muted">@(last.Sessions == 1 ? "1 session" : $"{last.Sessions} sessions")@(last.Minutes > 0 ? " · " + HomeLogic.Played(last.Minutes) + " played" : " so far")</span>
                        </span>
                        <span class="continue-go">Open</span>
                    </button>
                    @if (last.Role == "join" && last.With.Length > 0 && Friends?.FirstOrDefault(f => string.Equals(f.Name, last.With, StringComparison.OrdinalIgnoreCase)) is { } again)
                    {
                        <button class="mini rejoin" @onclick="() => OnJoinFriend.InvokeAsync(again)">Rejoin @again.Name, hosting now</button>
                    }
                    @if (History.Count > 0)
                    {
                        <ul class="history" aria-label="Earlier sessions">
                            @foreach (var h in History)
                            {
                                <li>
                                    <button class="history-row" @onclick="() => OnOpenGame.InvokeAsync(h.Game.Id)">
                                        <span class="friend-name">@h.Game.DisplayName</span>
                                        <span class="mod-state">@(h.Session.Role == "host" ? "Hosted" : h.Session.With.Length > 0 ? "Joined " + h.Session.With : "Joined") @HomeLogic.Ago(h.Session.LastUtc, DateTime.UtcNow)@(h.Session.Minutes > 0 ? " · " + HomeLogic.Played(h.Session.Minutes) : "")</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <p class="muted">Nothing played yet. Pick a game from the slideshow or the shelves below, download its mod, and start a session.</p>
                    <button class="link" @onclick="OnOpenLibrary">Browse the Library</button>
                }
            </section>

            @* Your numbers *@
            <section class="tile">
                <h2>Your numbers</h2>
                @if (TotalSessions == 0)
                {
                    <p class="muted">Your sessions and play time show up here once you host or join a game.</p>
                }
                else
                {
                    <ul class="stats">
                        <li><span class="stat-n">@TotalSessions</span><span>@(TotalSessions == 1 ? "session" : "sessions")</span></li>
                        <li><span class="stat-n">@(TotalMinutes > 0 ? HomeLogic.Played(TotalMinutes) : "-")</span><span>played</span></li>
                        <li><span class="stat-n stat-text">@MostPlayed</span><span>most played</span></li>
                    </ul>
                    <div class="tile-actions"><button class="mini" @onclick="OnOpenAccount">Open your account</button></div>
                }
            </section>

            @* Games you have, with no mod yet *@
            @if (Suggestions.Count > 0)
            {
                <section class="tile">
                    <h2>Ready to set up</h2>
                    <p class="muted">You have these games, and Cairn has a mod for each.</p>
                    <ul class="attention">
                        @foreach (var g in Suggestions)
                        {
                            <li><span class="attention-text">@g.DisplayName</span><button class="mini" @onclick="() => OnDownloadMod.InvokeAsync(g.Id)">Get the mod</button></li>
                        }
                    </ul>
                </section>
            }

            @* What is new in Cairn *@
            @if (Latest is { } news)
            {
                <section class="tile">
                    <h2>New in @news.Tag</h2>
                    @if (news.Items.Count == 0) { <p class="muted">Maintenance and stability improvements.</p> }
                    else
                    {
                        <ul class="news-lines">
                            @foreach (var line in news.Items.Take(3)) { <li>@line</li> }
                        </ul>
                    }
                    <div class="tile-actions"><button class="mini" @onclick="OnOpenNews">All the news</button></div>
                </section>
            }

            @* Library: how much of it is ready *@
            <section class="tile">
                <h2>Your library</h2>
                <ul class="stats">
                    <li><span class="stat-n">@GamesOnPc</span><span>@(GamesOnPc == 1 ? "game" : "games") on this PC</span></li>
                    <li><span class="stat-n">@ModsInstalled</span><span>@(ModsInstalled == 1 ? "mod" : "mods") installed</span></li>
                    <li><span class="stat-n">@FavoriteGames.Count</span><span>@(FavoriteGames.Count == 1 ? "favourite" : "favourites")</span></li>
                </ul>
                <div class="tile-actions">
                    <button class="mini" @onclick="OnOpenLibrary">Open the Library</button>
                    <button class="mini" @onclick="OnOpenSetup">@(SetupReady == true ? "Setup is ready" : SetupReady == false ? "Finish setup" : "Checking setup...")</button>
                </div>
            </section>
        </div>

        @if (FavoriteGames.Count > 0)
        {
            <section class="shelf">
                <h2>Favourites</h2>
                <div class="shelf-row">
                    @foreach (var g in FavoriteGames) { @Poster(g) }
                </div>
            </section>
        }

        @if (Playable.Count > 0)
        {
            <section class="shelf">
                <h2>Playable now</h2>
                <div class="shelf-row">
                    @foreach (var g in Playable) { @Poster(g) }
                </div>
            </section>
        }

        @if (FriendsActive.Count > 0)
        {
            <section class="shelf">
                <h2>Friends are playing <span class="count">@FriendsActive.Count</span></h2>
                <ul class="friends-grid">
                    @foreach (var f in FriendsActive)
                    {
                        <FriendRow Friend="f" Hosting="HostingAs(f)" Cairn="OnCairn(f)" CanInvite="CanInvite" Invited="Invited.Contains(f.Id)" OnJoin="OnJoinFriend" OnInvite="OnInvite" />
                    }
                </ul>
            </section>
        }

        @if (RecentGames.Count > 0)
        {
            <section class="shelf">
                <h2>Recently played</h2>
                <div class="shelf-row">
                    @foreach (var g in RecentGames) { @Poster(g) }
                </div>
            </section>
        }

        @if (ModNews.Count > 0)
        {
            <section class="shelf">
                <h2>From the mods</h2>
                <div class="mod-news">
                    @foreach (var (game, notes) in ModNews)
                    {
                        var latest = notes[0];
                        <button class="mod-news-card" @onclick="() => OnOpenGame.InvokeAsync(game.Id)">
                            <span class="mod-news-head"><strong>@game.DisplayName</strong><span class="muted">@latest.Tag@(latest.Published is { } when ? " · " + when.ToString("d MMM") : "")</span></span>
                            @if (latest.Items.Count == 0) { <span class="muted">Maintenance and stability improvements.</span> }
                            else
                            {
                                <ul>
                                    @foreach (var line in latest.Items.Take(3)) { <li>@line</li> }
                                </ul>
                            }
                        </button>
                    }
                </div>
            </section>
        }

        <section class="shelf">
            <h2>Tools</h2>
            <div class="tools">
                <button class="tool" @onclick="OnOpenSetup"><strong>Check setup</strong><span>Find what is missing for your games, and fix it.</span></button>
                <button class="tool" @onclick="OnSaveLogs"><strong>Save the logs</strong><span>One zip with the game's, the mod's and the launcher's logs.</span></button>
                <button class="tool" @onclick="OnReportBug"><strong>Report a problem</strong><span>Open the issue page, with what to attach.</span></button>
                <button class="tool" @onclick="OnReplayTour"><strong>Welcome guide</strong><span>The short walk through Cairn, again.</span></button>
            </div>
        </section>

        <section class="shelf">
            <h2>Tip of the day</h2>
            <div class="tip"><strong>@Tip.Title</strong><span>@Tip.Text</span></div>
        </section>

        @if (Upcoming.Count > 0)
        {
            <section class="shelf">
                <h2>Coming soon <span class="count">@Upcoming.Count</span></h2>
                <div class="shelf-row">
                    @foreach (var g in Upcoming) { @Poster(g) }
                </div>
            </section>
        }
    </div>
</div>

@code {
    private RenderFragment Poster(GameProfile g) => @<div class="poster-wrap">
        <button class="poster" @onclick="() => OnOpenGame.InvokeAsync(g.Id)" title="@g.DisplayName">
            <span class="poster-art" style="background-image: url('@(g.PosterImage.Length > 0 ? g.PosterImage : g.BackgroundImage)');"></span>
            <span class="poster-shade"></span>
            @if (IsOnPc(g)) { <span class="poster-flag">On this PC</span> }
            <span class="poster-name">@g.DisplayName</span>
            <span class="poster-sub">@(g.Developer.Length > 0 ? g.Developer : (g.IsSupported ? "Playable now" : "Coming soon"))</span>
        </button>
        <button class="heart @(Favorites.Contains(g.Id) ? "on" : "")" aria-label="@(Favorites.Contains(g.Id) ? "Remove from favourites" : "Add to favourites")" aria-pressed="@(Favorites.Contains(g.Id) ? "true" : "false")"
                title="@(Favorites.Contains(g.Id) ? "Remove from favourites" : "Add to favourites")" @onclick="() => OnToggleFavorite.InvokeAsync(g.Id)">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
    </div>;

    [Parameter] public IReadOnlyList<GameProfile> Games { get; set; } = Array.Empty<GameProfile>();
    [Parameter] public Func<GameProfile, bool>? OnPc { get; set; }
    [Parameter] public int GamesOnPc { get; set; }
    [Parameter] public int ModsInstalled { get; set; }
    [Parameter] public ReleaseNote? Latest { get; set; }
    /// <summary>The setup checklist's verdict; null while it is still being checked.</summary>
    [Parameter] public bool? SetupReady { get; set; }

    [Parameter] public string? UpdateTag { get; set; }
    [Parameter] public IReadOnlyList<string> UpdateNotes { get; set; } = Array.Empty<string>();
    [Parameter] public bool UpdateBusy { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }
    [Parameter] public IReadOnlyList<Cairn.Setup.Notice> Notices { get; set; } = Array.Empty<Cairn.Setup.Notice>();
    [Parameter] public EventCallback<string> OnDismissNotice { get; set; }

    [Parameter] public IReadOnlyList<GameProfile> Suggestions { get; set; } = Array.Empty<GameProfile>();
    [Parameter] public EventCallback<string> OnDownloadMod { get; set; }
    [Parameter] public int TotalSessions { get; set; }
    [Parameter] public int TotalMinutes { get; set; }
    [Parameter] public string MostPlayed { get; set; } = "";
    [Parameter] public EventCallback OnOpenAccount { get; set; }
    [Parameter] public EventCallback OnOpenNews { get; set; }
    /// <summary>The latest release of each mod the player has or follows.</summary>
    [Parameter] public IReadOnlyList<(GameProfile Game, IReadOnlyList<ReleaseNote> Notes)> ModNews { get; set; } = Array.Empty<(GameProfile, IReadOnlyList<ReleaseNote>)>();
    [Parameter] public EventCallback OnSaveLogs { get; set; }
    [Parameter] public EventCallback OnReportBug { get; set; }
    [Parameter] public EventCallback OnReplayTour { get; set; }
    /// <summary>The games played from here, the latest first.</summary>
    [Parameter] public IReadOnlyList<GameProfile> RecentGames { get; set; } = Array.Empty<GameProfile>();

    private IReadOnlyList<SteamFriendRow> FriendsActive => SteamFriends
        .Where(f => HostingAs(f) is not null || f.State == "in-game" || OnCairn(f) is { Online: true, Activity: "playing" or "hosting" })
        .OrderBy(f => HostingAs(f) is not null ? 0 : 1).ThenBy(f => f.Name, StringComparer.OrdinalIgnoreCase).Take(8).ToList();

    private static readonly (string Title, string Text)[] Tips =
    {
        ("Same version, same world", "Everyone in a session needs the same mod version. Cairn keeps your mods up to date by itself, so you only have to check when a friend is on an older one."),
        ("Something broke after an update?", "Open the game's page and press Go back: the version before the last update is restored, and it is not installed again by itself."),
        ("Favourites", "Press the heart on a game's poster and it comes first in the list and on this page."),
        ("Ready check", "Before you host or join, the ready check says what is missing and has a button for each problem."),
        ("Report a problem", "Save the logs from here, then attach the zip to your report: it holds the game's, the mod's and the launcher's logs."),
    };
    // one tip a day, then the next
    private (string Title, string Text) Tip => Tips[(int)(DateTime.UtcNow.DayOfYear % Tips.Length)];

    [Parameter] public RecentSession? Last { get; set; }
    [Parameter] public string FriendsState { get; set; } = "idle";
    [Parameter] public IReadOnlyList<SteamFriendData>? Friends { get; set; }
    [Parameter] public EventCallback<SteamFriendData> OnJoinFriend { get; set; }
    /// <summary>Every Steam friend and what they are doing; HostingAs finds the one hosting a session, when this friend is.</summary>
    [Parameter] public IReadOnlyList<SteamFriendRow> SteamFriends { get; set; } = Array.Empty<SteamFriendRow>();
    [Parameter] public bool SteamFriendsLoaded { get; set; }
    /// <summary>This player is hosting and the code is ready: a friend on Cairn can be invited with one click.</summary>
    [Parameter] public bool CanInvite { get; set; }
    [Parameter] public ISet<string> Invited { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<SteamFriendRow> OnInvite { get; set; }
    /// <summary>The friend as the presence feature sees them (online with Cairn, and what they do), or null.</summary>
    [Parameter] public Func<SteamFriendRow, Cairn.Wire.PresenceFriend?> OnCairn { get; set; } = _ => null;
    [Parameter] public Func<SteamFriendRow, SteamFriendData?> HostingAs { get; set; } = _ => null;
    /// <summary>The sessions before the last one, newest first.</summary>
    [Parameter] public IReadOnlyList<(GameProfile Game, RecentSession Session)> History { get; set; } = Array.Empty<(GameProfile, RecentSession)>();
    [Parameter] public ISet<string> Favorites { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<string> OnToggleFavorite { get; set; }

    [Parameter] public EventCallback<string> OnOpenGame { get; set; }
    [Parameter] public EventCallback OnOpenLibrary { get; set; }
    [Parameter] public EventCallback OnOpenVersions { get; set; }
    [Parameter] public EventCallback OnOpenHelp { get; set; }
    [Parameter] public EventCallback OnOpenSetup { get; set; }

    private int index;
    private CancellationTokenSource? cts;

    private string SetupText => SetupReady switch { true => "ready", false => "needs attention", _ => "checking" };
    private bool IsOnPc(GameProfile g) => OnPc?.Invoke(g) ?? false;
    private GameProfile? RecentGame => Last is null ? null : Games.FirstOrDefault(g => string.Equals(g.Id, Last.GameId, StringComparison.OrdinalIgnoreCase));

    // the playable games lead the slideshow, then the rest; only games with artwork can be shown
    private IReadOnlyList<GameProfile> Slides => Games.Where(g => g.BackgroundImage.Length > 0)
        .OrderByDescending(g => g.IsSupported).ThenBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).Take(8).ToList();
    private IReadOnlyList<GameProfile> Playable => Games.Where(g => g.IsSupported && g.BackgroundImage.Length > 0)
        .OrderBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    private IReadOnlyList<GameProfile> Upcoming => Games.Where(g => !g.IsSupported && g.BackgroundImage.Length > 0)
        .OrderBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    private IReadOnlyList<GameProfile> FavoriteGames => Games.Where(g => Favorites.Contains(g.Id) && g.BackgroundImage.Length > 0)
        .OrderBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();

    private string ArtFor(GameProfile g, bool active) =>
        g.HeroImage.Length > 0 ? g.HeroImage : g.BackgroundImage;

    private int slideCycle;

    private void GoTo(int i)
    {
        index = i;
        slideCycle++;
        RestartTimer();
    }

    private void Next()
    {
        index = (index + 1) % Math.Max(1, Slides.Count);
        slideCycle++;
        RestartTimer();
    }

    private void Previous()
    {
        index = (index - 1 + Slides.Count) % Math.Max(1, Slides.Count);
        slideCycle++;
        RestartTimer();
    }

    private void OnShowcaseKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") Next();
        else if (e.Key == "ArrowLeft") Previous();
    }

    private void RestartTimer()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;
        _ = RunTimerAsync(token);
    }

    private async Task RunTimerAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(7000, token);
                if (token.IsCancellationRequested || Slides.Count < 2) continue;
                await InvokeAsync(() =>
                {
                    index = (index + 1) % Math.Max(1, Slides.Count);
                    slideCycle++;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    protected override void OnInitialized()
    {
        RestartTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("cairnDragScroll"); }   // the poster rows can be dragged with the mouse
        catch (Exception) { /* a missing script only costs the dragging */ }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}
