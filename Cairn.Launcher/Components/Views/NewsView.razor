@using Cairn.Launcher.Models
@* What is new: the announcements, Cairn's latest releases, and the latest release of each mod. *@
<div class="view">
    <header class="view-head">
        <h1>News</h1>
        <p class="lead">Announcements, and what changed lately in Cairn and in each game's mod.</p>
    </header>

    @if (Notices.Count > 0)
    {
        <section class="card">
            <div class="card-head"><h2>Announcements</h2></div>
            <ul class="list">
                @foreach (var n in Notices)
                {
                    <li><strong>@n.Title</strong>@(n.Kind == Cairn.Setup.Notice.KnownIssue ? " (known issue)" : "") @n.Text</li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <div class="card-head">
            <h2>Cairn</h2>
            <button class="link" @onclick="OnOpenVersions">All releases</button>
        </div>
        @if (CairnReleases is null) { <p class="muted">Cairn's releases could not be loaded.</p> }
        else
        {
            @foreach (var r in CairnReleases.Take(2)) { <ReleaseBlock Note="r" /> }
        }
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Mods</h2>
            <button class="link" @onclick="OnRefresh" disabled="@Loading">@(Loading ? "Loading..." : "Refresh")</button>
        </div>
        @if (Loading && Mods.Count == 0)
        {
            <div class="tile-loading" role="status" aria-label="Loading"><span class="spinner"></span></div>
        }
        else if (Mods.Count == 0)
        {
            <p class="muted">No mod release could be loaded (no connection, or GitHub did not answer).</p>
        }
        else
        {
            @foreach (var (game, notes) in Mods)
            {
                <div class="news-game">
                    <button class="news-game-name" @onclick="() => OnOpenGame.InvokeAsync(game.Id)">@game.DisplayName</button>
                    @foreach (var r in notes) { <ReleaseBlock Note="r" /> }
                </div>
            }
        }
    </section>
</div>

@code {
    [Parameter] public IReadOnlyList<Cairn.Setup.Notice> Notices { get; set; } = Array.Empty<Cairn.Setup.Notice>();
    [Parameter] public IReadOnlyList<ReleaseNote>? CairnReleases { get; set; }
    [Parameter] public IReadOnlyList<(GameProfile Game, IReadOnlyList<ReleaseNote> Notes)> Mods { get; set; } = Array.Empty<(GameProfile, IReadOnlyList<ReleaseNote>)>();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnOpenVersions { get; set; }
    [Parameter] public EventCallback<string> OnOpenGame { get; set; }
}
