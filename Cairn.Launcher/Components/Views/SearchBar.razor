@using Cairn.Launcher.Models

@* The search box of the top bar (Ctrl+K puts the cursor in it): type a title, a studio or a franchise, and the matches drop down under
   it; Enter opens the first (or the one picked with Up and Down), Esc closes the list. *@
<div class="searchbar @(open ? "open" : "")" role="search">
    <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
    <input @ref="input" class="sb-input" type="text" autocomplete="off" spellcheck="false" placeholder="Search games" aria-label="Search games"
           aria-expanded="@(open ? "true" : "false")" aria-controls="search-results"
           value="@query" @oninput="OnInput" @onfocus="OnFocus" @onblur="OnBlur" @onkeydown="OnKey" />
    @if (query.Length > 0)
    {
        <button class="sb-clear" tabindex="-1" aria-label="Clear the search" @onmousedown:preventDefault="true" @onclick="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    }
    else
    {
        <kbd class="sb-kbd">Ctrl K</kbd>
    }

    @if (open && !string.IsNullOrWhiteSpace(query))
    {
        var found = Results();
        <ul id="search-results" class="sb-list" role="listbox">
            @for (int i = 0; i < found.Count; i++)
            {
                var g = found[i];
                int row = i;
                <li>
                    @* mouse down selects immediately before blur can destroy the list, click is also handled *@
                    <button class="sb-item @(i == selected ? "on" : "")" role="option" aria-selected="@(i == selected ? "true" : "false")"
                            @onmousedown="() => Pick(g.Id)" @onclick="() => Pick(g.Id)" @onmouseenter="() => selected = row">
                        <span class="sb-logo">@if (g.LogoImage.Length > 0) { <img src="@g.LogoImage" alt="" /> }</span>
                        <span class="sb-text">
                            <span class="sb-name">@g.DisplayName@if (Favorites.Contains(g.Id)) { <span class="fav-mark">&#9829;</span> }</span>
                            <span class="sb-sub">@(g.Developer.Length > 0 ? g.Developer : "")@(OnPc?.Invoke(g) == true ? " · On this PC" : "")@(g.IsSupported ? "" : " · Coming soon")</span>
                        </span>
                    </button>
                </li>
            }
            @if (found.Count == 0)
            {
                <li class="sb-empty">No game matches "@query".</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<GameProfile> Games { get; set; } = Array.Empty<GameProfile>();
    [Parameter] public Func<GameProfile, bool>? OnPc { get; set; }
    [Parameter] public ISet<string> Favorites { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<string> OnPick { get; set; }

    private string query = "";
    private int selected;
    private bool open;
    private Microsoft.AspNetCore.Components.ElementReference input;

    /// <summary>Whether the list is showing (Esc closes it before it leaves the launcher).</summary>
    public bool IsOpen => open;

    /// <summary>Ctrl+K: the cursor goes in the box.</summary>
    public async Task FocusAsync()
    {
        try { await input.FocusAsync(); } catch (Exception) { /* focus is a convenience */ }
    }

    /// <summary>Esc: close the list and empty the box (the next Esc leaves the launcher as usual).</summary>
    public void Close()
    {
        open = false;
        query = "";
        selected = 0;
        StateHasChanged();
    }

    private List<GameProfile> Results()
    {
        if (string.IsNullOrWhiteSpace(query)) return new List<GameProfile>();
        return Games.Where(g => GameListView.Matches(g, query.Trim()))
             .OrderByDescending(g => Favorites.Contains(g.Id)).ThenByDescending(g => g.IsSupported)
             .ThenBy(g => g.DisplayName, StringComparer.OrdinalIgnoreCase).Take(8).ToList();
    }

    private void OnInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        selected = 0;
        open = !string.IsNullOrWhiteSpace(query);
    }

    private void OnFocus()
    {
        open = !string.IsNullOrWhiteSpace(query);
    }

    private async Task OnBlur()
    {
        // Small delay so click / mousedown events on dropdown items register before tearing down the list
        await Task.Delay(200);
        open = false;
        StateHasChanged();
    }

    private void Clear()
    {
        query = "";
        selected = 0;
        open = false;
    }

    private async Task Pick(string gameId)
    {
        open = false;
        query = "";
        selected = 0;
        await OnPick.InvokeAsync(gameId);
    }

    private async Task OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        var found = Results();
        if (e.Key == "ArrowDown") { open = true; selected = Math.Min(found.Count - 1, selected + 1); }
        else if (e.Key == "ArrowUp") selected = Math.Max(0, selected - 1);
        else if (e.Key == "Enter" && open && found.Count > 0) await Pick(found[Math.Min(selected, found.Count - 1)].Id);

    }
}
