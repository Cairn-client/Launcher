mods - Shortcut.lnk
memory.md
.claude

# Build output
bin/
obj/
out/
Debug/
Release/
publish/

# Visual Studio / Rider IDE state — never commit
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Probe output, regenerated per run
tools/probe-results.txt

# Compiled installer test harness (tools/Test-InstallerDetect.ps1 rebuilds it)
installer/tests/*.exe

# Native build tree (CMake + Ninja), and the plugin's own log
native/build/
cairn-native.log

# The launcher's own log, written next to the repo root when it runs
kcd_launcher.log

# Steam probe probe reports (curate before committing anything from them)
steam_probe-probe-*.txt

# Python bytecode from the save tools (Read-SaveAnatomy.py imported by scripts)
tools/__pycache__/

# the frame-rate soak's raw runs (the committed record carries the tables)
tools/perf/runs/

# the code-signing settings (docs/CODE-SIGNING.md) -- never committed
tools/signing.local.json

# a private reference study -- never committed or pushed
research/

# the bundled start saves are the maintainer's play data: copied into the release build, never committed
assets/start-save/*/*.whs

# the maintainer's tester bundles (zips of the players' logs) -- private, never committed
/logs/

# a launcher run from a source folder writes its settings here
settings.json
